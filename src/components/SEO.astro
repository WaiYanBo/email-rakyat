---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string | URL;
  noindex?: boolean;
  keywords?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  image = "/logo.png",
  url = Astro.url,
  noindex = false,
  keywords,
  type = 'website'
} = Astro.props;

const siteTitle = "Bantuan Mangsa Ah Long: Ugutan, Simbah Cat & Sebar Gambar | Team Email Rakyat (ER Advocacy)";
const defaultDescription = "Kena ugut Ah Long? Ahlong is harassing or threatening me? Ketahui apa itu Ah Long, cara hadapi kes Ah Long di Malaysia, ugutan simbah cat, sebar gambar IC & panduan lapor polis sah bersama Team Email Rakyat (ER Advocacy Sdn. Bhd.).";
const siteDescription = description || defaultDescription;

const defaultKeywords = "apa itu ah long, ah long ugut saya, ah long kacau saya, kes ah long malaysia, kena ugut ah long, ah long simbah cat, ah long sebar gambar, ah long datang rumah, ah long kunci pagar, ah long kacau tempat kerja, cara lapor polis ah long, cara selesai hutang ah long, bayar pokok sahaja ah long, tak mampu bayar bunga ah long, bantuan mangsa ah long, nombor telefon bantuan ah long, hotline mangsa ah long, ahlong is harassing me, ahlong cases malaysia, ahlong threatening me, what is ahlong, loan shark harassment malaysia, how to deal with ah long, loan shark splashed paint malaysia, loan shark threatening family, bantuan mangsa ah long, cara setel hutang ah long, gangguan debt collector, aduan kredit komuniti kpkt, er advocacy sdn bhd, team email rakyat, email rakyat, raja emel bantuan mangsa ah long";
const pageKeywords = keywords ? `${keywords}, ${defaultKeywords}` : defaultKeywords;

const socialImageURL = new URL(image, Astro.site || Astro.url).href;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url).href;

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LegalService",
      "@id": "https://e-rakyat.com/#organization",
      "name": "Team Email Rakyat",
      "legalName": "ER Advocacy Sdn. Bhd.",
      "alternateName": [
        "Email Rakyat",
        "ER Advocacy",
        "ER Advocacy Sdn Bhd",
        "Pusat Advokasi & Bantuan Mangsa Ah Long Malaysia",
        "Team Raja Emel"
      ],
      "disambiguatingDescription": "Firma perunding advokasi dan khidmat nasihat mangsa Ah Long swasta berdaftar di Malaysia (ER Advocacy Sdn Bhd).",
      "url": "https://e-rakyat.com",
      "logo": new URL("/logo.png", Astro.site || Astro.url).href,
      "image": socialImageURL,
      "description": siteDescription,
      "priceRange": "$$",
      "areaServed": [
        {
          "@type": "Country",
          "name": "Malaysia"
        }
      ],
      "knowsLanguage": ["ms", "en", "zh"],
      "serviceType": [
        "Bantuan Kecemasan Mangsa Ah Long (Ahlong Threatening Me / Harassing Me)",
        "Penyelesaian Kes Ah Long Malaysia",
        "Panduan Apa Itu Ah Long & Hak Pengguna",
        "Khidmat Nasihat Selesai Bayar Pokok Sahaja",
        "Bantuan Laporan Polis Simbah Cat & Sebar Gambar IC",
        "Advokasi Gangguan Debt Collector & Syarikat Pinjaman"
      ],
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": "+6012-6232949",
          "contactType": "emergency",
          "areaServed": "MY",
          "availableLanguage": ["Malay", "English"]
        }
      ],
      "sameAs": [
        "https://www.tiktok.com/@teamemail.rakyat",
        "https://WaiYanTeamEmailRakyat.wasap.my"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://e-rakyat.com/#website",
      "url": "https://e-rakyat.com",
      "name": "Email Rakyat",
      "description": "Portal Rasmi Advokasi & Bantuan Mangsa Ah Long Malaysia (ER Advocacy Sdn. Bhd.)",
      "publisher": {
        "@id": "https://e-rakyat.com/#organization"
      },
      "inLanguage": "ms-MY"
    },
    {
      "@type": "FAQPage",
      "@id": "https://e-rakyat.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa itu Ah Long dan bagaimana mengenalinya? (What is Ah Long)",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ah Long adalah peminjam wang haram tanpa lesen di bawah Akta Pemberi Pinjam Wang 1951. Mereka sering mengenakan kadar bunga melampau, memegang kad ATM/IC mangsa, meminta bayaran 'wang proses' upfront, dan menggunakan taktik ugutan, simbah cat atau memeras ugut apabila mangsa tidak mampu membayar bunga harian/mingguan."
          }
        },
        {
          "@type": "Question",
          "name": "Ah Long ugut saya atau kacau keluarga (Ahlong is harassing me / Ahlong threatening me), apa langkah pertama?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Jangan panik dan jangan terus bayar wang bunga kerana bayaran ugutan tidak akan menyelesaikan hutang. Kumpul dan simpan semua bukti seperti mesej WhatsApp, gambar ugutan, nombor telefon, dan transaksi bank. Hubungi Team Email Rakyat untuk panduan menyusun kronologi fakta bagi membuat laporan polis rasmi secara sah dan selamat."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana cara selesaikan kes Ah Long di Malaysia jika bunga makin naik? (Kes Ah Long Malaysia)",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dalam kes Ah Long di Malaysia, kadar faedah haram yang melampau tidak sah di sisi undang-undang. Ramai mangsa terperangkap kerana bayar bunga berganda tanpa mengurangkan wang pokok. Kami membimbing mangsa menggunakan saluran undang-undang untuk menyekat pemerasan dan hanya menyelesaikan jumlah pinjaman pokok sebenar (full settlement modal) secara rasmi."
          }
        },
        {
          "@type": "Question",
          "name": "Bolehkah Ah Long simbah cat merah atau sebar gambar IC dan aib saya?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Menyimbah cat merah, mengunci pagar rumah, ugut bunuh atau menyebarkan gambar IC dan fitnah maruah mangsa di media sosial/WhatsApp adalah kesalahan jenayah berat di bawah Seksyen 503/506 Kanun Keseksaan dan Seksyen 233 Akta Komunikasi dan Multimedia 1998. Pihak polis boleh membuka Kertas Siasatan (Investigation Paper) dengan bukti laporan yang lengkap."
          }
        },
        {
          "@type": "Question",
          "name": "Boleh ke saya bayar pinjaman pokok sahaja kepada Ah Long?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Boleh dan itu kaedah yang disarankan di sisi undang-undang. Kadar bunga Ah Long adalah haram dan tidak diiktiraf mahkamah. Dengan bantuan advokasi dan sokongan laporan polis, mangsa boleh menghentikan bayaran bunga dan hanya menyelesaikan jumlah pinjaman modal pokok yang diterima sahaja."
          }
        },
        {
          "@type": "Question",
          "name": "Adakah saya akan ditangkap polis jika buat laporan polis kena ugut Ah Long?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tidak. Menjadi mangsa pemerasan atau peminjam bukanlah jenayah yang menyebabkan anda ditangkap. Sebaliknya, polis memerlukan laporan anda untuk menyiasat jenayah ugutan jenayah, khianat harta (simbah cat), dan aktiviti pinjaman haram sindiket."
          }
        }
      ]
    }
  ]
};
---
<title>{title || siteTitle}</title>
<meta name="title" content={title || siteTitle} />
<meta name="description" content={siteDescription} />
<meta name="keywords" content={pageKeywords} />
<meta name="author" content="Team Email Rakyat (ER Advocacy Sdn. Bhd.)" />
<link rel="canonical" href={canonicalURL} />
<meta name="theme-color" content="#111827" />

<link rel="alternate" hreflang="ms-MY" href={canonicalURL} />
<link rel="alternate" hreflang="x-default" href={canonicalURL} />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
)}

<meta property="og:site_name" content="Email Rakyat" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title || siteTitle} />
<meta property="og:description" content={siteDescription} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:alt" content="Team Email Rakyat - Advokasi & Bantuan Mangsa Ah Long" />
<meta property="og:locale" content="ms_MY" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title || siteTitle} />
<meta name="twitter:description" content={siteDescription} />
<meta name="twitter:image" content={socialImageURL} />
<meta name="twitter:image:alt" content="Team Email Rakyat" />

<script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />