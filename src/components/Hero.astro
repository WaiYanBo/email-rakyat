---
import { Image } from "astro:assets";
import defaultBg from "../assets/hero-executive.jpg";

interface Props {
  line1?: string;
  line2?: string;
  line3?: string;
  showDetails?: boolean;
  backgroundImage?: any;
}

const {
  line1 = "Selesaikan Isu Ah Long Secara Sah.",
  line2 = "Sulit · Profesional · Berlandaskan Undang-Undang",
  showDetails = true,
  backgroundImage = defaultBg,
} = Astro.props;
---

{showDetails ? (
  <section class="hero-banner relative min-h-[75vh] md:min-h-[84vh] pt-36 pb-20 md:pt-44 md:pb-28 flex items-end bg-[#070c18] text-white overflow-hidden">
    <!-- Crisp Professional Banner Photography -->
    <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <Image
        src={backgroundImage}
        alt="Team Email Rakyat Pusat Advokasi Pengguna Malaysia"
        class="w-full h-full object-cover object-center opacity-100"
        loading="eager"
        fetchpriority="high"
        widths={[640, 1024, 1536, 1920]}
        sizes="100vw"
      />
      <!-- Balanced Cinematic Gradient so the Photo Shines Through Clearly -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#070c18] via-[#070c18]/55 to-[#070c18]/40" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#070c18]/85 via-[#070c18]/40 to-transparent" />
    </div>

    <div class="site-container relative z-10 w-full">
      <div class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-[#f0c351] mb-4 drop-shadow">
          Team Email Rakyat &middot; Malaysia
        </p>

        <h1
          class="h-display text-white tracking-tight mb-5 drop-shadow-md"
          style="color: #ffffff !important;"
        >
          Selesaikan Isu Ah Long
          <span class="text-[#f0c351] block mt-1">Secara Sah.</span>
        </h1>

        <p
          class="hero-subtitle text-sm sm:text-base text-slate-200 tracking-wide mb-9 drop-shadow"
          style="color: #f1f5f9 !important;"
        >
          Sulit &middot; Profesional &middot; Berlandaskan Undang-Undang
        </p>

        <div class="flex flex-wrap items-center gap-6">
          <a href="/hubungi" class="btn-primary !bg-[#e2b03a] hover:!bg-[#f0c351] !text-[#070c18]">
            Dapatkan Bantuan
          </a>

          <a
            href="/perkhidmatan"
            class="link-arrow text-white hover:text-[#f0c351] py-2 drop-shadow"
            style="color: #ffffff !important;"
          >
            Lihat Perkhidmatan
          </a>
        </div>
      </div>
    </div>
  </section>
) : (
  <header class="hero-banner relative min-h-[340px] md:min-h-[420px] pt-36 pb-14 md:pt-44 md:pb-20 flex items-end bg-[#070c18] text-white border-b border-white/10 overflow-hidden">
    <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <Image
        src={backgroundImage}
        alt={line1}
        class="w-full h-full object-cover object-center opacity-100"
        loading="eager"
        widths={[640, 1024, 1536, 1920]}
        sizes="100vw"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#070c18] via-[#070c18]/50 to-[#070c18]/40" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#070c18]/80 via-[#070c18]/35 to-transparent" />
    </div>

    <div class="site-container relative z-10 w-full">
      <div class="max-w-2xl">
        {line2 && (
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#f0c351] mb-3 drop-shadow">
            {line2}
          </p>
        )}

        <h1
          class="h-page text-white tracking-tight drop-shadow-md"
          style="color: #ffffff !important;"
        >
          {line1}
        </h1>
      </div>
    </div>
  </header>
)}

<style is:global>
  html[data-theme="light"] .hero-banner .h-display,
  html[data-theme="light"] .hero-banner .h-page,
  html.theme-light .hero-banner .h-display,
  html.theme-light .hero-banner .h-page,
  .hero-banner .h-display,
  .hero-banner .h-page {
    color: #ffffff !important;
  }

  html[data-theme="light"] .hero-banner .link-arrow,
  html.theme-light .hero-banner .link-arrow,
  .hero-banner .link-arrow {
    color: #ffffff !important;
  }

  html[data-theme="light"] .hero-banner .link-arrow:hover,
  html.theme-light .hero-banner .link-arrow:hover,
  .hero-banner .link-arrow:hover {
    color: #f0c351 !important;
  }
</style>
