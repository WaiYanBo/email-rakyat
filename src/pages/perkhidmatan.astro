---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FAQ from '../components/FAQ.astro';
import serviceBg from '../assets/perkhidmatan-banner.webp';

const services = [
  {
    id: "ahlong",
    title: "Mangsa Pinjaman Wang Tanpa Lesen (Ah Long)",
    description: "Kami menyediakan khidmat nasihat serta bantuan kepada individu yang menjadi mangsa pinjaman wang tanpa lesen (Ah Long). Segala tindakan dan panduan yang diberikan adalah berlandaskan undang-undang, dan tidak melibatkan sebarang rundingan dengan sindiket atau Ah Long."
  },
  {
    id: "collector",
    title: "Gangguan Debt Collector & Hutang Lapuk",
    description: "Kami menyediakan khidmat nasihat serta membantu penghutang sebagai perantara antara pihak pemiutang (bank atau syarikat kredit) bagi mendapatkan tawaran penyelesaian bayaran penuh (full settlement) atau penjadualan semula pinjaman yang jelas, telus, dan berdasarkan jumlah sebenar yang dipersetujui."
  },
  {
    id: "kredit",
    title: "Salah Laku Syarikat Kredit Komuniti",
    description: "Kami menyediakan khidmat nasihat, serta bantuan kepada penghutang untuk membuat aduan kepada Kementerian Perumahan dan Kerajaan Tempatan (KPKT) berkaitan salah laku antaranya jumlah faedah, penyelewengan kewangan, dan pelanggaran undang-undang oleh syarikat Kredit Komuniti."
  },
  {
    id: "hak",
    title: "Hak & Perlindungan Pengguna",
    description: "Khidmat nasihat berkaitan hak pengguna dan perlindungan undang-undang terhadap penindasan pengguna."
  }
];

const steps = [
  {
    id: 1,
    title: "Kumpul Bukti",
    description: "Analisis bukti ancaman dan pengesahan fakta kes."
  },
  {
    id: 2,
    title: "Draf Repot",
    description: "Penyusunan fakta kronologi untuk laporan polis yang teknikal."
  },
  {
    id: 3,
    title: "Proses Undang-Undang",
    description: "Desakan agar Kertas Siasatan (Investigation Paper) dibuka untuk pendakwaan."
  },
  {
    id: 4,
    title: "Pemantauan Kes",
    description: "Rekod corak gangguan susulan sebagai bukti tambahan."
  }
];
---

<Layout
  title="Perkhidmatan Selesai Kes Ah Long & Khidmat Nasihat Hutang Sah | Team Email Rakyat"
  description="Khidmat bantuan kes Ah Long Malaysia, gangguan ugutan ceti haram, debt collector agresif, dan penyelesaian hutang bayar pokok sahaja secara sah oleh Team Email Rakyat."
>
  <Hero
    line1="Perkhidmatan Kami"
    line2="Advokasi & Perlindungan Undang-Undang"
    showDetails={false}
    backgroundImage={serviceBg}
  />

  <main class="site-container py-16 md:py-24">
    <!-- Header -->
    <div class="max-w-3xl mb-16 md:mb-20">
      <span class="eyebrow eyebrow-accent mb-4 block">Bidang Kuasa &amp; Skop Tindakan</span>
      <h2 class="h-page mb-6">
        Solusi advokasi, bimbingan fakta, dan perlindungan pengguna.
      </h2>
      <p class="lead">
        Team Email Rakyat menyediakan perkhidmatan bantuan dan nasihat perundangan khusus untuk orang awam secara berintegriti, bebas daripada kompromi sindiket.
      </p>
    </div>

    <!-- Services: Clean Linear Divided List (Zero Boxes) -->
    <section class="border-t border-[var(--site-line)] divide-y divide-[var(--site-line)]">
      {
        services.map((service, index) => (
          <article id={service.id} class="py-10 md:py-14 scroll-mt-28 grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-start">
            <div class="md:col-span-1 text-sm font-mono font-bold text-[var(--site-accent)]">
              {String(index + 1).padStart(2, "0")}
            </div>

            <div class="md:col-span-5">
              <h3 class="text-xl md:text-2xl font-bold text-[var(--site-heading)] tracking-tight">
                {service.title}
              </h3>
            </div>

            <div class="md:col-span-6">
              <p class="body-text text-sm md:text-base leading-relaxed">
                {service.description}
              </p>
            </div>
          </article>
        ))
      }
    </section>

    <!-- Methodology: Clean 4-Phase Flow (Zero Boxes) -->
    <section class="site-section mt-16 md:mt-24">
      <div class="max-w-2xl mb-14 md:mb-16">
        <span class="eyebrow eyebrow-accent mb-3 block">Metodologi Tindakan</span>
        <h2 class="h-section">Proses 4 Fasa Pemulihan Kes</h2>
        <p class="lead mt-3">
          Langkah kerja sistematik dan berlandaskan statut undang-undang bagi menjamin keselamatan mangsa dan keluarga.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10 border-t border-[var(--site-line)] pt-10">
        {
          steps.map((step) => (
            <div class="flex flex-col">
              <span class="text-xs font-mono font-bold text-[var(--site-accent)] mb-3 block">
                FASA {String(step.id).padStart(2, "0")}
              </span>
              <h3 class="h-item mb-2 text-[var(--site-heading)]">
                {step.title}
              </h3>
              <p class="body-text text-sm leading-relaxed">
                {step.description}
              </p>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <FAQ />
</Layout>
