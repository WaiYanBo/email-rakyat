---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const panduanEntries = await getCollection('panduan');
  return panduanEntries.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;

const baseUrl = Astro.site ? Astro.site.origin : 'https://e-rakyat.com';
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).href;
const ogImage = new URL(data.image || '/logo.png', baseUrl).href;

const formattedPublishDate = new Intl.DateTimeFormat('ms-MY', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(data.publishDate);

const formattedUpdateDate = data.updatedDate
  ? new Intl.DateTimeFormat('ms-MY', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    }).format(data.updatedDate)
  : null;

// JSON-LD Structured Data for Article & Schema Compliance
const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${baseUrl}/#website`,
        "name": "Email Rakyat",
        "url": baseUrl
      },
      "headline": data.metaTitle || data.title,
      "description": data.description,
      "inLanguage": "ms-MY",
      "mainEntityOfPage": canonicalUrl,
      "datePublished": data.publishDate.toISOString(),
      "dateModified": (data.updatedDate || data.publishDate).toISOString(),
      "author": {
        "@type": "Organization",
        "name": data.author,
        "url": baseUrl
      },
      "publisher": {
        "@type": "Organization",
        "name": "Team Email Rakyat",
        "url": baseUrl,
        "logo": {
          "@type": "ImageObject",
          "url": `${baseUrl}/logo.png`
        }
      },
      "image": ogImage,
      "keywords": data.keywords.join(", ")
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Utama",
          "item": baseUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Panduan & Advokasi",
          "item": `${baseUrl}/panduan`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": data.title,
          "item": canonicalUrl
        }
      ]
    },
    ...(data.faqs && data.faqs.length > 0
      ? [
          {
            "@type": "FAQPage",
            "@id": `${canonicalUrl}#faq`,
            "mainEntity": data.faqs.map((faq) => ({
              "@type": "Question",
              "name": faq.question,
              "acceptedAnswer": {
                "@type": "Answer",
                "text": faq.answer
              }
            }))
          }
        ]
      : [])
  ]
};
---

<Layout
  title={data.metaTitle || data.title}
  description={data.description}
>
  <Fragment slot="head">
    <meta name="keywords" content={data.keywords.join(", ")} />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={data.publishDate.toISOString()} />
    {data.updatedDate && (
      <meta property="article:modified_time" content={data.updatedDate.toISOString()} />
    )}
    <meta property="article:section" content={data.category} />
    {data.keywords.map((kw) => (
      <meta property="article:tag" content={kw} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
  </Fragment>

  <!-- Top Header Banner (Dark Backdrop so Navbar Camouflage works seamlessly) -->
  <header class="hero-banner relative pt-32 pb-12 md:pt-36 md:pb-16 bg-[#070c18] text-white border-b border-white/10">
    <div class="site-container">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-2 text-xs font-mono text-slate-400">
        <a href="/" class="hover:text-[#f0c351] transition-colors" style="color: #cbd5e1 !important;">Utama</a>
        <span>/</span>
        <a href="/panduan" class="hover:text-[#f0c351] transition-colors" style="color: #cbd5e1 !important;">Panduan</a>
        <span>/</span>
        <span class="text-[#f0c351] truncate max-w-[220px] sm:max-w-md">{data.title}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-3 mb-4 text-xs font-mono uppercase">
        <span class="text-[#f0c351] font-bold">{data.badge}</span>
        <span class="text-slate-500">·</span>
        <span class="text-slate-300" style="color: #cbd5e1 !important;">{data.category}</span>
        <span class="text-slate-500">·</span>
        <span class="text-slate-300" style="color: #cbd5e1 !important;">⏱ {data.readTime}</span>
      </div>

      <h1 class="h-page text-white max-w-4xl mb-5" style="color: #ffffff !important;">
        {data.title}
      </h1>

      <p class="hero-subtitle text-sm sm:text-base md:text-lg text-slate-200 leading-relaxed max-w-3xl mb-8" style="color: #f1f5f9 !important;">
        {data.description}
      </p>

      <!-- Author & Date Bar (Divided Line, Zero Box) -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-6 border-t border-white/15 text-xs">
        <div>
          <p class="font-bold text-white uppercase tracking-wider" style="color: #ffffff !important;">{data.author}</p>
          <p class="text-slate-300 text-[11px]" style="color: #cbd5e1 !important;">{data.authorRole}</p>
        </div>
        <div class="text-[11px] font-mono text-slate-300 flex flex-col sm:items-end" style="color: #cbd5e1 !important;">
          <span>Diterbitkan: <strong class="text-white" style="color: #ffffff !important;">{formattedPublishDate}</strong></span>
          {formattedUpdateDate && (
            <span>Dikemas kini: <strong class="text-[#f0c351]">{formattedUpdateDate}</strong></span>
          )}
        </div>
      </div>
    </div>
  </header>

  <div class="w-full bg-[var(--site-bg)] text-[var(--site-text)] py-12 md:py-16">
    <div class="site-container">

      <!-- Urgent Hotline Notice (Divided Line, No Box) -->
      <aside aria-label="Talian Kecemasan" class="mb-10 pb-8 border-b border-[var(--site-line)]">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="flex h-2 w-2 relative shrink-0">
              <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
            </span>
            <p class="text-xs sm:text-sm font-semibold text-[var(--site-heading)] leading-snug">
              Sedang diugut atau diserang Ah Long sekarang? Jangan panik &amp; jangan terus bayar wang bunga ugutan.
            </p>
          </div>
          <a
            href="https://WaiYanTeamEmailRakyat.wasap.my"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary !py-2 !px-4 !text-xs shrink-0"
          >
            <span>WhatsApp Kecemasan</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>

      <!-- Mobile Quick TOC Accordion (< lg only) -->
      {headings && headings.length > 0 && (
        <details class="lg:hidden mb-8 pb-6 border-b border-[var(--site-line)]">
          <summary class="flex items-center justify-between cursor-pointer list-none font-bold text-xs font-mono uppercase tracking-wider text-[var(--site-accent)]">
            <span>Lompat Ke Bahagian Panduan ({headings.filter(h => h.depth <= 3).length})</span>
            <span class="text-[var(--site-subtle)]">▼</span>
          </summary>
          <nav class="mt-3 pt-3 border-t border-[var(--site-line)] space-y-2 text-xs">
            {headings
              .filter((h) => h.depth <= 3)
              .map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class={`block transition-colors hover:text-[var(--site-accent)] py-0.5 ${
                    heading.depth === 2
                      ? 'font-bold text-[var(--site-heading)] pl-0'
                      : 'text-[var(--site-muted)] pl-3 border-l border-[var(--site-line)]'
                  }`}
                >
                  {heading.text}
                </a>
              ))}
          </nav>
        </details>
      )}

      <!-- Editorial Split: Article on Left (8 cols) + Sticky Sidebar on Right (4 cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">

        <!-- Main Article Body (Pure Editorial Typography, Zero Outer Box) -->
        <article class="lg:col-span-8 w-full min-w-0 pillar-article no-reveal">

          <!-- Law Sections Quick Highlight (Editorial Divided List, Zero Boxes) -->
          {data.lawSections && data.lawSections.length > 0 && (
            <section class="mb-12 border-b border-[var(--site-line)] pb-8">
              <span class="eyebrow eyebrow-accent mb-2 block">
                Perisai Statut Perundangan Malaysia
              </span>
              <h2 class="text-xl md:text-2xl font-bold text-[var(--site-heading)] mb-6">
                Seksyen Undang-Undang Yang Melindungi Mangsa
              </h2>
              <div class="divide-y divide-[var(--site-line)] border-t border-[var(--site-line)]">
                {data.lawSections.map((law) => (
                  <div class="py-5">
                    <p class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--site-accent)] mb-1">
                      {law.section}
                    </p>
                    <h3 class="text-base font-bold text-[var(--site-heading)] mb-1.5 leading-snug">
                      {law.title}
                    </h3>
                    <p class="body-text text-sm leading-relaxed mb-2">
                      {law.description}
                    </p>
                    <p class="text-xs font-mono font-semibold text-red-500">
                      Hukuman: {law.legalPenalty}
                    </p>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Markdown Content Body (Unboxed Editorial Text) -->
          <div class="pillar-content break-words">
            <Content />
          </div>

          <!-- FAQ Accordion (Divided Lines, Zero Boxes) -->
          {data.faqs && data.faqs.length > 0 && (
            <section class="mt-14 sm:mt-16 pt-10 sm:pt-12 border-t border-[var(--site-line)]">
              <div class="mb-8">
                <span class="eyebrow eyebrow-accent mb-2 block">
                  Soalan Lazim Perundangan
                </span>
                <h2 class="text-2xl font-bold text-[var(--site-heading)] mb-2">
                  Soalan Kerap Ditanya Mengenai Tindakan Undang-Undang
                </h2>
                <p class="body-text text-sm">
                  Jawapan rasmi dan bimbingan keselamatan berlandaskan statut undang-undang jenayah Malaysia.
                </p>
              </div>

              <div class="border-t border-[var(--site-line)] divide-y divide-[var(--site-line)]">
                {data.faqs.map((faq, idx) => (
                  <details class="disclosure group py-5">
                    <summary class="flex justify-between items-center cursor-pointer list-none font-bold text-sm sm:text-base text-[var(--site-heading)] hover:text-[var(--site-accent)] transition-colors">
                      <span class="flex items-start gap-3 pr-4">
                        <span class="text-[var(--site-accent)] font-mono text-xs mt-0.5">{String(idx + 1).padStart(2, '0')}.</span>
                        <span>{faq.question}</span>
                      </span>
                      <span class="disclosure-icon"></span>
                    </summary>
                    <div class="mt-3 text-sm text-[var(--site-muted)] leading-relaxed pl-7">
                      <p>{faq.answer}</p>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )}

          <!-- Bottom Help CTA (Unboxed) -->
          <footer class="mt-16 pt-12 border-t border-[var(--site-line)]">
            <h2 class="text-2xl font-bold text-[var(--site-heading)] mb-3">
              Jangan Tanggung Ketakutan Ini Bersendirian
            </h2>
            <p class="body-text text-sm max-w-xl mb-6">
              Pegawai advokasi Team Email Rakyat sedia membimbing anda menyusun kronologi fakta kes dan laporan polis teknikal untuk menghentikan pemerasan serta-merta.
            </p>
            <div class="flex flex-wrap items-center gap-4">
              <a
                href="https://WaiYanTeamEmailRakyat.wasap.my"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary"
              >
                <span>Dapatkan Bantuan Sulit Sekarang</span>
                <span aria-hidden="true">→</span>
              </a>
              <a
                href="/hubungi"
                class="btn-secondary"
              >
                Hubungi Kami
              </a>
            </div>
          </footer>

        </article>

        <!-- Desktop Sidebar (Left Border Divider, Zero Boxes) -->
        <aside class="lg:col-span-4 w-full lg:border-l border-[var(--site-line)] lg:pl-8">
          <div class="sticky top-28 space-y-10">

            <!-- Desktop Table of Contents -->
            {headings && headings.length > 0 && (
              <div class="hidden lg:block pb-8 border-b border-[var(--site-line)]">
                <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--site-accent)] mb-4">
                  Isi Kandungan Panduan
                </h2>
                <nav class="space-y-2 text-xs max-h-[50vh] overflow-y-auto pr-2">
                  {headings
                    .filter((h) => h.depth <= 3)
                    .map((heading) => (
                      <a
                        href={`#${heading.slug}`}
                        class={`block transition-colors hover:text-[var(--site-accent)] ${
                          heading.depth === 2
                            ? 'font-bold text-[var(--site-heading)] pl-0 py-0.5'
                            : 'text-[var(--site-muted)] pl-3 border-l border-[var(--site-line)] hover:border-[var(--site-accent)] py-0.5'
                        }`}
                      >
                        {heading.text}
                      </a>
                    ))}
                </nav>
              </div>
            )}

            <!-- Quick Action Note (Unboxed) -->
            <div class="space-y-3">
              <span class="eyebrow eyebrow-accent block">
                Semakan Kes Percuma
              </span>
              <h3 class="text-lg font-bold text-[var(--site-heading)]">
                Perlukan Semakan Kes Anda?
              </h3>
              <p class="body-text text-xs leading-relaxed">
                Hantar bukti ugutan WhatsApp dan rekod transaksi kepada pegawai bertugas kami untuk semakan liabiliti secara percuma &amp; sulit.
              </p>
              <div class="pt-2">
                <a
                  href="https://WaiYanTeamEmailRakyat.wasap.my"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary w-full text-xs !py-2.5"
                >
                  <span>Hubungi Pegawai Bertugas</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>

          </div>
        </aside>

      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* Ensure article and pillar content are never hidden by scroll observers */
  .pillar-article,
  .pillar-content,
  .pillar-content *,
  .no-reveal,
  .no-reveal * {
    opacity: 1 !important;
    transform: none !important;
    visibility: visible !important;
  }

  /* Clear fixed navbar on anchor jump */
  html {
    scroll-padding-top: 6.5rem;
    scroll-behavior: smooth;
  }

  .pillar-content [id],
  .pillar-article [id],
  h2[id],
  h3[id],
  section[id] {
    scroll-margin-top: 7rem !important;
  }

  /* Theme-Adaptive Rich Pillar Typography Styling */
  .pillar-content h1 {
    display: none;
  }

  .pillar-content h2 {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--site-heading);
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--site-line-strong);
  }

  .pillar-content h2:first-child {
    margin-top: 0;
  }

  @media (min-width: 640px) {
    .pillar-content h2 {
      font-size: 1.65rem;
      margin-top: 2.5rem;
    }
  }

  .pillar-content h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--site-accent);
    margin-top: 1.75rem;
    margin-bottom: 0.65rem;
    line-height: 1.35;
  }

  @media (min-width: 640px) {
    .pillar-content h3 {
      font-size: 1.25rem;
    }
  }

  .pillar-content p {
    font-size: 0.95rem;
    color: var(--site-muted);
    line-height: 1.8;
    margin-bottom: 1.15rem;
  }

  @media (min-width: 640px) {
    .pillar-content p {
      font-size: 1rem;
    }
  }

  .pillar-content blockquote {
    border-left: 3px solid var(--site-accent);
    padding: 0.5rem 0 0.5rem 1.25rem;
    margin: 1.35rem 0;
    color: var(--site-heading);
  }

  .pillar-content blockquote p {
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--site-text);
  }

  .pillar-content blockquote p:last-child {
    margin-bottom: 0;
  }

  .pillar-content ul, .pillar-content ol {
    margin: 1.15rem 0;
    padding-left: 1.25rem;
    color: var(--site-muted);
  }

  .pillar-content ul {
    list-style-type: disc;
  }

  .pillar-content ol {
    list-style-type: decimal;
  }

  .pillar-content li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .pillar-content strong {
    color: var(--site-heading);
    font-weight: 700;
  }

  .pillar-content a {
    color: var(--site-accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pillar-content hr {
    border: 0;
    border-top: 1px solid var(--site-line);
    margin: 2.25rem 0;
  }
</style>
