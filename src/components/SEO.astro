---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string | URL;
  noindex?: boolean;
  keywords?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  image = "/logo.png",
  url = Astro.url,
  noindex = false,
  keywords,
  type = 'website'
} = Astro.props;

const siteTitle = "Bantuan Mangsa Ah Long & Khidmat Nasihat Hutang Sah | Team Email Rakyat (ER Advocacy)";
const defaultDescription = "Perunding advokasi & khidmat nasihat profesional mangsa Ah Long, pinjaman wang tanpa lesen, gangguan debt collector agresif, dan aduan salah laku kredit komuniti (KPKT) di Malaysia oleh ER Advocacy Sdn. Bhd.";
const siteDescription = description || defaultDescription;

// Real Malaysian high-intent user search queries
const defaultKeywords = "bantuan mangsa ah long, cara setel hutang ah long, kena ugut ah long apa nak buat, ah long ugut sebar gambar, lapor polis ah long, selesai hutang ah long cara sah, gangguan debt collector, cara hadapi pengutip hutang, aduan kredit komuniti kpkt, rundingan hutang lapuk, khidmat nasihat hutang ah long, er advocacy sdn bhd, raja emel bantuan mangsa ah long, debt settlement malaysia";
const pageKeywords = keywords ? `${keywords}, ${defaultKeywords}` : defaultKeywords;

// Absolute Social Image URL
const socialImageURL = new URL(image, Astro.site || Astro.url).href;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url).href;

// JSON-LD Schemas: Legal & Advocacy Service + Local Business + FAQPage
const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LegalService",
      "@id": "https://e-rakyat.com/#organization",
      "name": "Team Email Rakyat",
      "legalName": "ER Advocacy Sdn. Bhd.",
      "alternateName": [
        "Email Rakyat",
        "ER Advocacy",
        "ER Advocacy Sdn Bhd",
        "Pusat Advokasi & Bantuan Mangsa Ah Long Malaysia",
        "Team Raja Emel"
      ],
      "disambiguatingDescription": "Firma perunding advokasi dan khidmat nasihat mangsa Ah Long swasta berdaftar di Malaysia (ER Advocacy Sdn Bhd).",
      "url": "https://e-rakyat.com",
      "logo": new URL("/logo.png", Astro.site || Astro.url).href,
      "image": socialImageURL,
      "description": siteDescription,
      "priceRange": "$$",
      "areaServed": [
        {
          "@type": "Country",
          "name": "Malaysia"
        }
      ],
      "knowsLanguage": ["ms", "en", "zh"],
      "serviceType": [
        "Khidmat Nasihat Mangsa Ah Long",
        "Advokasi & Perlindungan Hak Pengguna",
        "Penyelesaian Gangguan Debt Collector",
        "Aduan Salah Laku Syarikat Kredit Komuniti KPKT",
        "Bantuan Draf Laporan Polis & Kertas Siasatan"
      ],
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": "+6012-6232949",
          "contactType": "emergency",
          "areaServed": "MY",
          "availableLanguage": ["Malay", "English"]
        }
      ],
      "sameAs": [
        "https://www.tiktok.com/@teamemail.rakyat",
        "https://WaiYanTeamEmailRakyat.wasap.my"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://e-rakyat.com/#website",
      "url": "https://e-rakyat.com",
      "name": "Email Rakyat",
      "description": "Portal Rasmi Advokasi & Bantuan Mangsa Ah Long Malaysia (ER Advocacy Sdn. Bhd.)",
      "publisher": {
        "@id": "https://e-rakyat.com/#organization"
      },
      "inLanguage": "ms-MY"
    },
    {
      "@type": "FAQPage",
      "@id": "https://e-rakyat.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa yang perlu dilakukan jika diugut oleh Ah Long?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Jangan panik dan elakkan daripada terus membayar wang bunga yang tidak berkesudahan. Kumpulkan dan simpan semua bukti seperti mesej WhatsApp, rakaman panggilan, dan slip transaksi akaun bank. Hubungi Team Email Rakyat (ER Advocacy Sdn. Bhd.) untuk mendapatkan panduan menyusun fakta kes kronologi bagi membuat laporan polis teknikal mengikut saluran undang-undang yang sah."
          }
        },
        {
          "@type": "Question",
          "name": "Bolehkah Ah Long menyebarkan gambar atau mengganggu keluarga di tempat kerja?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sebarang perbuatan ugutan jenayah, memeras ugut, atau menyebarkan gambar peribadi adalah kesalahan jenayah serius di bawah Kanun Keseksaan dan Akta Komunikasi dan Multimedia 1998. Pasukan kami membantu mangsa merangka laporan rasmi supaya Kertas Siasatan (Investigation Paper) dapat dibuka oleh pihak berkuasa."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana cara menangani gangguan daripada Debt Collector (Pengutip Hutang)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pengutip hutang tertakluk kepada garis panduan undang-undang dan dilarang menggunakan taktik ugutan atau mengganggu pihak ketiga. Kami menyediakan khidmat perundingan bagi membantu semakan baki hutang sebenar serta merundingkan tawaran penyelesaian penuh (full settlement) atau penjadualan semula bayaran yang telus."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa lama masa yang diambil untuk menghentikan gangguan sindiket Ah Long?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tindakan segera diambil sebaik sahaja dokumen dan bukti kronologi lengkap disemak oleh pegawai ER Advocacy Sdn. Bhd. Bimbingan teknikal dan saluran undang-undang yang tepat membantu mangsa menyekat ancaman sindiket dengan pantas tanpa perlu terus tunduk kepada pemerasan wang bunga."
          }
        }
      ]
    }
  ]
};
---
<title>{title || siteTitle}</title>
<meta name="title" content={title || siteTitle} />
<meta name="description" content={siteDescription} />
<meta name="keywords" content={pageKeywords} />
<meta name="author" content="Team Email Rakyat (ER Advocacy Sdn. Bhd.)" />
<link rel="canonical" href={canonicalURL} />
<meta name="theme-color" content="#111827" />

{/* Language Alternates */}
<link rel="alternate" hreflang="ms-MY" href={canonicalURL} />
<link rel="alternate" hreflang="x-default" href={canonicalURL} />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
)}

{/* OpenGraph / Facebook / WhatsApp */}
<meta property="og:site_name" content="Email Rakyat" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title || siteTitle} />
<meta property="og:description" content={siteDescription} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:alt" content="Team Email Rakyat - Advokasi & Bantuan Mangsa Ah Long" />
<meta property="og:locale" content="ms_MY" />

{/* Twitter Cards */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title || siteTitle} />
<meta name="twitter:description" content={siteDescription} />
<meta name="twitter:image" content={socialImageURL} />
<meta name="twitter:image:alt" content="Team Email Rakyat" />

{/* Structured Data (JSON-LD) */}
<script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />