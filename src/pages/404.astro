---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Halaman Tidak Dijumpai" noindex={true}>
  <main class="site-container min-h-[70vh] flex flex-col items-center justify-center text-center py-20">
    <span class="eyebrow eyebrow-accent mb-4 block">Ralat 404</span>
    <h1 class="h-display mb-4">Halaman Tidak Dijumpai</h1>
    <p class="lead max-w-md mb-8">Halaman yang anda cari mungkin telah dipindahkan atau tidak lagi wujud.</p>

    <a href="/" class="btn-primary">
      <span>Kembali ke Halaman Utama</span>
      <span aria-hidden="true">→</span>
    </a>
  </main>
</Layout>