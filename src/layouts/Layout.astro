---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import '../styles/public.css';
import '@fontsource-variable/nunito-sans';

interface Props {
    title?: string;
    description?: string;
    image?: string;
    noindex?: boolean;
}

const {
    title = "Bantuan Mangsa Ah Long & Khidmat Nasihat Hutang Sah | Team Email Rakyat",
    description = "Perunding advokasi & khidmat nasihat profesional mangsa Ah Long, pinjaman wang tanpa lesen, gangguan debt collector agresif, dan aduan salah laku kredit komuniti (KPKT) di Malaysia oleh Team Email Rakyat.",
    image,
    noindex = false
} = Astro.props;
const currentPath = Astro.url.pathname;
const isPortal = currentPath.startsWith('/portal');
---

<!doctype html>
<html lang="ms">
    <head>
        <meta charset="utf-8" />
        <SEO title={title} description={description} noindex={noindex || isPortal} />
        <link rel="icon" type="image/x-icon" href="/favicon.ico?v=4" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
        <link rel="icon" type="image/png" sizes="32x32" href="/logo-v2.png?v=4" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=4" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <meta name="apple-mobile-web-app-title" content="Email Rakyat" />
        <link rel="manifest" href="/manifest.json?v=4" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="google-site-verification" content="t7vCzrQZCriZtremnWdNAfm_3wHw7RG8Fm6TU6vQjR8" />

        {isPortal && (
            <>
              <meta
                http-equiv="Content-Security-Policy"
                content={[
                  "default-src 'self'",
                  "script-src 'self' 'unsafe-inline' https://www.googletagmanager.com",
                  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
                  "font-src 'self' https://fonts.gstatic.com",
                  "img-src 'self' blob: data: https:",
                  "connect-src 'self' blob: https://*.supabase.co wss://*.supabase.co https://www.google-analytics.com https://translate.googleapis.com",
                  "frame-src 'self' https://*.supabase.co https://view.officeapps.live.com",
                  "media-src 'self' blob: https://*.supabase.co",
                  "worker-src 'self' blob:",
                  "object-src 'none'",
                  "base-uri 'self'",
                  "form-action 'self'",
                ].join('; ')}
              />
            </>
        )}

        {isPortal && (
            <script is:inline>
                try {
                    const theme = localStorage.getItem('portal-theme') || 'dark';
                    if (theme === 'dark') document.documentElement.classList.add('dark');
                    else document.documentElement.classList.remove('dark');
                } catch (e) {}

                (function() {
                    if (typeof window !== 'undefined' && 'Notification' in window) {
                        function requestNotif() {
                            if (Notification.permission === 'default') {
                                Notification.requestPermission().catch(function() {});
                            }
                        }
                        requestNotif();
                        ['click', 'touchstart', 'pointerdown'].forEach(function(evt) {
                            window.addEventListener(evt, requestNotif, { once: true, passive: true });
                        });
                    }
                })();
            </script>
        )}

        <slot name="head" />
        <script src="/scripts/analytics.js" defer></script>

        <script is:inline>
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    navigator.serviceWorker.register('/sw.js').catch(() => {});
                });
            }
        </script>
        {!isPortal && (
          <>
            <script is:inline>
              (function() {
                try {
                  var stored = localStorage.getItem('public-theme');
                  var theme = stored || 'dark';
                  document.documentElement.setAttribute('data-theme', theme);
                  if (theme === 'light') {
                    document.documentElement.classList.add('theme-light');
                    document.documentElement.classList.remove('theme-dark');
                  } else {
                    document.documentElement.classList.add('theme-dark');
                    document.documentElement.classList.remove('theme-light');
                  }
                } catch (e) {}
              })();
            </script>
            <script is:inline>
              window.loadGtag = function() {
                if (window.gtagLoaded) return;
                window.gtagLoaded = true;

                const script = document.createElement('script');
                script.async = true;
                script.src = "https://www.googletagmanager.com/gtag/js?id=AW-18262341649";
                document.head.appendChild(script);

                window.dataLayer = window.dataLayer || [];
                window.gtag = function(){dataLayer.push(arguments);}
                window.gtag('js', new Date());
                window.gtag('config', 'AW-18262341649');
              };

              window.gtag_report_conversion = function(url) {
                if (typeof window.gtag === 'function') {
                  window.gtag('event', 'conversion', {
                    'send_to': 'AW-18262341649'
                  });
                }
                return true;
              };

              try {
                const prefsString = localStorage.getItem("cookie_preferences");
                if (prefsString) {
                  const prefs = JSON.parse(prefsString);
                  if (prefs.device) {
                    window.loadGtag();
                  }
                }
              } catch (e) {
                console.error("Failed checking consent:", e);
              }
            </script>
          </>
        )}
    </head>

    <body class:list={[
        "font-sans min-h-screen flex flex-col",
        isPortal ? "portal-layout bg-gray-50 text-gray-900 dark:bg-black dark:text-gray-100 transition-colors duration-300" : "site-public"
    ]}>

        {!isPortal && <Navbar />}

        <main class="flex-grow">
            <slot />
        </main>

        {!isPortal && (
            <>
                <div id="cookie-overlay" class="fixed bottom-0 inset-x-0 sm:bottom-6 sm:left-6 sm:right-auto sm:max-w-sm z-[60] hidden">
                    <div id="cookie-step-1" class="bg-[var(--site-surface)] border-t sm:border border-[var(--site-line)] sm:rounded-xl p-5 shadow-2xl flex flex-col gap-3">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                            <h3 class="text-sm font-bold text-[var(--site-heading)]">Privasi &amp; Analitik</h3>
                        </div>
                        <p class="text-xs text-[var(--site-muted)] leading-relaxed">
                            Laman web ini mengumpul data awanama (tanpa maklumat peribadi) dan kuki untuk analisis bagi membantu kami menambah baik platform ini.
                        </p>
                        <div class="flex items-center justify-end gap-3 w-full pt-1 text-xs">
                            <button id="btn-decline" class="text-[var(--site-subtle)] hover:text-[var(--site-heading)] font-semibold transition-colors">Tolak</button>
                            <button id="btn-manage" class="text-[var(--site-subtle)] hover:text-[var(--site-heading)] font-semibold transition-colors">Tetapan</button>
                            <button id="btn-accept-all" class="px-3.5 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold transition-all shadow-sm">Terima semua</button>
                        </div>
                    </div>

                    <div id="cookie-step-2" class="bg-[var(--site-surface)] border-t sm:border border-[var(--site-line)] sm:rounded-xl p-5 shadow-2xl flex flex-col gap-2 hidden"></div>
                    <template id="template-cookie-step-2">
                        <h3 class="text-sm font-bold text-[var(--site-heading)] mb-1">Tetapan Kuki</h3>
                        <p class="text-xs text-[var(--site-muted)] mb-3">
                            Pilih data yang anda benarkan kami kumpul.
                        </p>
                        <div class="divide-y divide-[var(--site-line)] border-y border-[var(--site-line)] mb-4">
                            <div class="flex items-start justify-between py-3">
                                <div class="pr-3">
                                    <h4 class="text-[var(--site-heading)] font-semibold text-xs">Analitik tanpa nama (wajib)</h4>
                                    <p class="text-[11px] text-[var(--site-subtle)] mt-0.5">Merekod masa skrin menggunakan ID sementara. Tiada data peribadi dikumpul.</p>
                                </div>
                                <input type="checkbox" checked disabled class="mt-1 w-4 h-4 accent-amber-500 opacity-50 cursor-not-allowed" aria-label="Wajib">
                            </div>
                            <div class="flex items-start justify-between py-3">
                                <div class="pr-3">
                                    <h4 class="text-[var(--site-heading)] font-semibold text-xs">Analitik peranti (pilihan)</h4>
                                    <p class="text-[11px] text-[var(--site-subtle)] mt-0.5">Merekod jenis peranti bagi menambah baik paparan.</p>
                                </div>
                                <input type="checkbox" id="toggle-device" class="mt-1 w-4 h-4 accent-amber-500 cursor-pointer" aria-label="Pilihan Peranti">
                            </div>
                        </div>
                        <div class="flex items-center justify-end gap-3 w-full text-xs">
                            <button id="btn-back" class="text-[var(--site-subtle)] hover:text-[var(--site-heading)] font-semibold transition-colors">Kembali</button>
                            <button id="btn-save-prefs" class="px-3.5 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold transition-all shadow-sm">Simpan pilihan</button>
                        </div>
                    </template>
                </div>

                <Footer />

                <button id="back-to-top" aria-label="Kembali ke atas" class="fixed bottom-20 sm:bottom-24 right-4 sm:right-6 z-40 bg-[var(--site-surface)] border border-[var(--site-line)] hover:border-[var(--site-accent)] text-[var(--site-muted)] hover:text-[var(--site-accent)] w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition-all duration-300 opacity-0 pointer-events-none translate-y-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                    </svg>
                </button>

                <div id="whatsapp-fab" class="fixed bottom-4 sm:bottom-6 right-4 sm:right-6 z-50 transition-opacity duration-300">
                    <a href="https://WaiYanTeamEmailRakyat.wasap.my" target="_blank" onclick="gtag_report_conversion();" class="flex items-center justify-center gap-2 bg-[#1f9d55] hover:bg-[#1a8a4a] text-white w-12 h-12 sm:w-auto sm:h-auto sm:px-4 sm:py-2.5 rounded-full shadow-lg shadow-black/40 transition-colors" aria-label="Contact on WhatsApp">
                        <svg class="w-5 h-5 fill-current flex-shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.008-.57-.008-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.304-5.292c0-5.448 4.435-9.88 9.884-9.88 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                        </svg>
                        <span class="hidden sm:inline text-sm font-medium">WhatsApp kami</span>
                    </a>
                </div>
            </>
        )}

        <style is:global>
            .reveal-on-scroll {
                opacity: 0;
                transform: translateY(30px);
                transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
                will-change: opacity, transform;
            }
            .reveal-on-scroll.is-revealed { opacity: 1; transform: translateY(0); }
            .grid > .reveal-on-scroll:nth-child(1) { transition-delay: 0.1s; }
            .grid > .reveal-on-scroll:nth-child(2) { transition-delay: 0.2s; }
            .grid > .reveal-on-scroll:nth-child(3) { transition-delay: 0.3s; }
            .grid > .reveal-on-scroll:nth-child(4) { transition-delay: 0.4s; }
            .grid > .reveal-on-scroll:nth-child(5) { transition-delay: 0.5s; }
            .grid > .reveal-on-scroll:nth-child(6) { transition-delay: 0.6s; }
        </style>

        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const overlay = document.getElementById("cookie-overlay");
                const step1 = document.getElementById("cookie-step-1");
                const step2 = document.getElementById("cookie-step-2");
                const templateStep2 = document.getElementById("template-cookie-step-2") as HTMLTemplateElement;
                const btnAcceptAll = document.getElementById("btn-accept-all");
                const btnDecline = document.getElementById("btn-decline");
                const btnManage = document.getElementById("btn-manage");
                const whatsappFab = document.getElementById("whatsapp-fab");

                if (!overlay || !step1 || !step2 || !btnAcceptAll || !btnDecline || !btnManage) return;

                const savedPrefs = localStorage.getItem("cookie_preferences");
                const currentPage = window.location.pathname;
                const isBantuanPage = currentPage.startsWith('/bantuan');
                const isPolicyPage = currentPage.startsWith('/polisi-kuki');

                if (!savedPrefs && !isBantuanPage && !isPolicyPage) {
                    overlay.classList.remove("hidden");
                    if (whatsappFab && window.matchMedia("(max-width: 639px)").matches) {
                        whatsappFab.classList.add("hidden");
                    }
                }

                btnManage.addEventListener("click", () => {
                    if (templateStep2 && step2.children.length === 0) {
                        step2.appendChild(templateStep2.content.cloneNode(true));
                        const btnBack = document.getElementById("btn-back");
                        const btnSavePrefs = document.getElementById("btn-save-prefs");
                        const toggleDevice = document.getElementById("toggle-device") as HTMLInputElement;

                        btnBack?.addEventListener("click", () => {
                            step2.classList.add("hidden");
                            step1.classList.remove("hidden");
                        });

                        btnSavePrefs?.addEventListener("click", () => {
                            localStorage.setItem("cookie_preferences", JSON.stringify({ essential: true, device: toggleDevice ? toggleDevice.checked : false }));
                            if (toggleDevice?.checked && typeof (window as any).loadGtag === 'function') {
                                (window as any).loadGtag();
                            }
                            dismissBanner();
                        });
                    }

                    step1.classList.add("hidden");
                    step2.classList.remove("hidden");
                    const toggleDevice = document.getElementById("toggle-device") as HTMLInputElement;
                    if (toggleDevice) {
                        toggleDevice.checked = savedPrefs ? JSON.parse(savedPrefs).device : false;
                    }
                });

                btnAcceptAll.addEventListener("click", () => {
                    localStorage.setItem("cookie_preferences", JSON.stringify({ essential: true, device: true }));
                    if (typeof (window as any).loadGtag === 'function') (window as any).loadGtag();
                    dismissBanner();
                });

                btnDecline.addEventListener("click", () => {
                    localStorage.setItem("cookie_preferences", JSON.stringify({ essential: true, device: false }));
                    dismissBanner();
                });

                function dismissBanner() {
                    overlay?.classList.add("hidden");
                    if (whatsappFab) {
                        whatsappFab.classList.remove("hidden");
                    }
                }
            });

            document.addEventListener("DOMContentLoaded", () => {
                const revealOptions = { root: null, rootMargin: "50px 0px 0px 0px", threshold: 0 };
                const revealObserver = new IntersectionObserver((entries, observer) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("is-revealed");
                            observer.unobserve(entry.target);
                        }
                    });
                }, revealOptions);

                const elementsToReveal = document.querySelectorAll('main section:not(.no-reveal):not(:first-of-type), main .reveal-item');
                elementsToReveal.forEach((el) => {
                    el.classList.add("reveal-on-scroll");
                    revealObserver.observe(el);
                });

                const backToTopBtn = document.getElementById('back-to-top');
                if (backToTopBtn) {
                    let topTicking = false;
                    window.addEventListener('scroll', () => {
                        if (!topTicking) {
                            window.requestAnimationFrame(() => {
                                if (window.scrollY > 300) {
                                    backToTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
                                    backToTopBtn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
                                } else {
                                    backToTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
                                    backToTopBtn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
                                }
                                topTicking = false;
                            });
                            topTicking = true;
                        }
                    }, { passive: true });

                    backToTopBtn.addEventListener('click', () => {
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    });
                }
            });
        </script>
    </body>
</html>