---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { Image } from "astro:assets";
import beritaBg from "../assets/banner-berita.jpg";
import icWarningImg from "../assets/FOR RISEMALAYSIA PURPOSE.jpg";

const newsSeries = [
    {
        id: 6,
        videoId: "o85GfbXwxFk",
        category: "ISU SEMASA",
        date: "04 MAY 2026",
        title: "Bukan kerana nama atau hero tapi kepuasan hidup",
        thumbnail: "https://img.youtube.com/vi/o85GfbXwxFk/hqdefault.jpg",
        duration: "01:22",
    },
    {
        id: 5,
        videoId: "p5Y950lb5_M",
        category: "ISU SEMASA",
        date: "28 APR 2026",
        title: "Raja Emel akan teruskan perjuangan bela nasib Rakyat Malaysia",
        thumbnail: "https://img.youtube.com/vi/p5Y950lb5_M/hqdefault.jpg",
        duration: "02:47",
    },
    {
        id: 4,
        videoId: "ifaZE16Q-RA",
        category: "ISU SEMASA",
        date: "21 JAN 2026",
        title: "Jangan buat pinjaman skim KWSP",
        thumbnail: "https://img.youtube.com/vi/ifaZE16Q-RA/hqdefault.jpg",
        duration: "01:44",
    },
    {
        id: 1,
        videoId: "aG9Hck9dloQ",
        category: "ISU SEMASA",
        date: "23 NOV 2025",
        title: "Saman Kerajaan Malaysia jika keselamatan rakyat tidak dijaga",
        thumbnail: "https://img.youtube.com/vi/aG9Hck9dloQ/hqdefault.jpg",
        duration: "01:55",
    },
    {
        id: 2,
        videoId: "LabuboNDKNQ",
        category: "ISU SEMASA",
        date: "10 NOV 2025",
        title: "HENTI BAYAR AH LONG!! GUNA KUASA UNDANG-UNDANG",
        thumbnail: "https://img.youtube.com/vi/LabuboNDKNQ/hqdefault.jpg",
        duration: "00:43",
    },
    {
        id: 3,
        videoId: "WwjMB9csqJA",
        category: "ISU SEMASA",
        date: "09 OCT 2025",
        title: "Siapa cakap kami tidak berani pergi misi bantuan gaza",
        thumbnail: "https://img.youtube.com/vi/WwjMB9csqJA/hqdefault.jpg",
        duration: "02:33",
    },
];
---

<Layout
    title="Berita & Panduan Keselamatan Mangsa Ah Long | Email Rakyat"
    description="Tonton video pendedahan kes sebenar, tips elak perangkap pinjaman wang haram, panduan keselamatan palang IC, dan hak anda sebagai pengguna di Malaysia."
>
    <Hero
      line1="Berita & Media"
      line2="Liputan & Pendedahan Kes Sebenar"
      showDetails={false}
      backgroundImage={beritaBg}
    />

    <main class="site-container py-16 md:py-24">
        <!-- Header -->
        <div class="max-w-3xl mb-16 md:mb-20">
            <span class="eyebrow eyebrow-accent mb-4">Pendedahan &amp; Arkib Media</span>
            <h2 class="h-page mt-2 mb-6">
                Liputan berita dan kupasan kes sebenar.
            </h2>
            <p class="lead">
                Koleksi video pendedahan taktik sindiket pinjaman tanpa lesen, hak perundangan mangsa, dan panduan perlindungan keluarga oleh Team Email Rakyat.
            </p>
        </div>

        <!-- Video Catalogue: Editorial Linear Rows Divided by Hairlines (Zero Boxed Grids, Only Necessary Video Thumbnail Frames) -->
        <div class="border-y border-[var(--site-line)] divide-y divide-[var(--site-line)]">
            {
                newsSeries.map((item, idx) => (
                    <article class="editorial-row py-8 md:py-10 grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-center group">
                        <div class="md:col-span-5 lg:col-span-4">
                            <div
                                class="relative aspect-video w-full bg-[var(--site-surface-subtle)] rounded overflow-hidden border border-[var(--site-line)] cursor-pointer play-trigger"
                                data-video={item.videoId}
                            >
                                <img
                                    src={item.thumbnail}
                                    alt={item.title}
                                    width="480"
                                    height="360"
                                    class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
                                    loading="lazy"
                                />
                                <div class="absolute bottom-3 right-3 bg-[#060b16]/90 text-white font-mono text-[11px] px-2 py-0.5 rounded border border-white/15 shadow-sm">
                                    {item.duration}
                                </div>
                                <div class="absolute inset-0 flex items-center justify-center video-play-overlay">
                                    <div class="w-12 h-12 rounded-full video-play-btn flex items-center justify-center">
                                        <svg class="w-5 h-5 ml-0.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M8 5v14l11-7z"/>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="md:col-span-7 lg:col-span-8 flex flex-col items-start">
                            <div class="flex items-center gap-3 text-xs font-mono text-[var(--site-subtle)] uppercase mb-2.5">
                                <span class="text-[var(--site-accent)] font-bold">0{idx + 1}</span>
                                <span>·</span>
                                <span>{item.date}</span>
                                <span>·</span>
                                <span class="text-[var(--site-accent)] font-bold">{item.category}</span>
                            </div>
                            <h3 class="text-xl md:text-2xl font-bold text-[var(--site-heading)] leading-snug mb-4 group-hover:text-[var(--site-accent)] transition-colors tracking-tight">
                                <button
                                    type="button"
                                    class="play-trigger text-left"
                                    data-video={item.videoId}
                                >
                                    {item.title}
                                </button>
                            </h3>
                            <button
                                type="button"
                                class="link-arrow play-trigger text-sm text-left"
                                data-video={item.videoId}
                            >
                                Tonton Rakaman Video
                            </button>
                        </div>
                    </article>
                ))
            }
        </div>

        <!-- IC Safety Advisory: Minimalist Editorial Notice (Zero Outer Box, Only Necessary Photo Frame) -->
        <section class="site-section mt-16 md:mt-24 !border-t-0 !pt-4">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
                <div class="md:col-span-5">
                    <div class="bg-[var(--site-surface)] p-3 rounded border border-[var(--site-line)] inline-block shadow-sm">
                        <Image
                            src={icWarningImg}
                            alt="Contoh Cara Palang Kad Pengenalan (IC)"
                            class="w-full max-w-[340px] h-auto object-contain"
                        />
                    </div>
                </div>

                <div class="md:col-span-7 space-y-4">
                    <span class="eyebrow text-red-500 dark:text-red-400">Langkah Keselamatan Wajib</span>
                    <h2 class="h-section">
                        Panduan Palang Kad Pengenalan (IC)
                    </h2>
                    <p class="body-text text-base leading-relaxed">
                        Apabila anda perlu memberikan salinan Kad Pengenalan secara atas talian untuk sebarang urusan, <strong class="text-[var(--site-heading)] font-bold">jangan sesekali serahkan salinan kosong</strong>.
                    </p>
                    <div class="border-l-2 border-[var(--site-accent)] pl-5 py-1 text-sm md:text-base text-[var(--site-muted)] leading-relaxed">
                        Sila pastikan anda meletakkan palang/watermark dua garisan lurus melintang dan nyatakan tujuan serahan spesifik pada bucu penjuru IC anda (seperti contoh gambar). Langkah ini penting bagi menyekat sindiket daripada memanipulasi dokumen pengenalan anda untuk pinjaman tanpa izin.
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Video Modal Container -->
    <div
        id="video-modal"
        class="hidden fixed inset-0 z-[100] flex items-center justify-center px-4"
    >
        <div
            id="modal-overlay"
            class="absolute inset-0 bg-black/90 backdrop-blur-sm cursor-pointer transition-opacity duration-300"
        >
        </div>
        <div
            class="relative w-full max-w-4xl bg-zinc-950 rounded-lg overflow-hidden border border-white/15 shadow-2xl"
        >
            <button
                id="close-modal"
                class="absolute top-3 right-3 z-30 text-white/70 hover:text-white bg-black/60 hover:bg-white/10 w-9 h-9 rounded flex items-center justify-center text-xl transition-colors border border-white/10"
                aria-label="Tutup video"
                >&times;</button
            >

            <div
                class="relative aspect-video w-full flex items-center justify-center bg-black"
            >
                <div
                    id="loading-spinner"
                    class="absolute z-10 flex flex-col items-center justify-center hidden"
                >
                    <div
                        class="animate-spin rounded-full h-10 w-10 border-2 border-white/20 border-t-[var(--site-accent)] mb-3"
                    >
                    </div>
                    <span
                        class="text-xs font-mono uppercase text-[var(--site-subtle)] tracking-wider"
                        >Memuatkan video...</span
                    >
                </div>

                <iframe
                    id="modal-iframe"
                    class="absolute inset-0 w-full h-full z-20 opacity-0 transition-opacity duration-500 ease-in-out"
                    src=""
                    title="YouTube video player"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
            </div>
        </div>
    </div>

    <script src="/scripts/berita-modal.js" defer></script>
</Layout>
