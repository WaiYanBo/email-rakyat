---
---

<section class="bg-black py-20 relative overflow-hidden">

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">

    <div class="mb-10">
        <div class="inline-block px-3 py-1 mb-4 text-[10px] font-semibold tracking-wider text-yellow-500 uppercase bg-yellow-500/10 rounded-full border border-yellow-500/20">
          Khidmat Masyarakat
        </div>

        <h2 class="text-3xl md:text-5xl font-black text-white mb-6 leading-tight">
          TEAM <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-yellow-600">
            EMAIL RAKYAT
          </span>
        </h2>

        <p class="text-gray-400 text-sm leading-relaxed max-w-2xl mx-auto">
          Kami menyediakan perkhidmatan bantuan dan khidmat nasihat kepada orang awam. Misi kami adalah melindungi hak anda daripada penindasan.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto text-left">

        <a href="/panduan/cara-selesaikan-hutang-ah-long-bayar-pokok" class="bg-gray-900/60 backdrop-blur-md p-6 rounded-lg border border-gray-700/50 hover:border-yellow-500/50 transition-all duration-300 group block">
            <div class="flex items-start justify-between">
                <div class="flex items-start">
                    <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded bg-black border border-gray-700 text-yellow-500 text-xs font-bold mr-4 group-hover:border-yellow-500 transition-colors">1</div>
                    <div>
                        <p class="text-gray-300 text-sm group-hover:text-white transition-colors pt-1">
                            Mangsa pinjaman wang tanpa lesen <span class="text-white font-bold block mt-1">(Ah Long)</span>
                        </p>
                        <span class="inline-flex items-center text-xs text-yellow-500/80 group-hover:text-yellow-400 mt-2 font-medium">
                            Baca Panduan Bayar Pokok &rarr;
                        </span>
                    </div>
                </div>
            </div>
        </a>

        <a href="/panduan/hak-peminjam-gangguan-debt-collector-malaysia" class="bg-gray-900/60 backdrop-blur-md p-6 rounded-lg border border-gray-700/50 hover:border-yellow-500/50 transition-all duration-300 group block">
            <div class="flex items-start justify-between">
                <div class="flex items-start">
                    <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded bg-black border border-gray-700 text-yellow-500 text-xs font-bold mr-4 group-hover:border-yellow-500 transition-colors">2</div>
                    <div>
                        <p class="text-gray-300 text-sm group-hover:text-white transition-colors pt-1">
                            Gangguan oleh <span class="text-white font-bold block mt-1">Debt Collector (Hutang Lapuk)</span>
                        </p>
                        <span class="inline-flex items-center text-xs text-yellow-500/80 group-hover:text-yellow-400 mt-2 font-medium">
                            Ketahui Had Masa & Hak Anda &rarr;
                        </span>
                    </div>
                </div>
            </div>
        </a>

        <a href="/panduan/aduan-kredit-komuniti-kpkt-bunga-tinggi" class="bg-gray-900/60 backdrop-blur-md p-6 rounded-lg border border-gray-700/50 hover:border-yellow-500/50 transition-all duration-300 group block">
            <div class="flex items-start justify-between">
                <div class="flex items-start">
                    <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded bg-black border border-gray-700 text-yellow-500 text-xs font-bold mr-4 group-hover:border-yellow-500 transition-colors">3</div>
                    <div>
                        <p class="text-gray-300 text-sm group-hover:text-white transition-colors pt-1">
                            Salah laku & penyelewengan <span class="text-white font-bold block mt-1">Syarikat Kredit Komuniti</span>
                        </p>
                        <span class="inline-flex items-center text-xs text-yellow-500/80 group-hover:text-yellow-400 mt-2 font-medium">
                            Prosedur Aduan Rasmi KPKT &rarr;
                        </span>
                    </div>
                </div>
            </div>
        </a>

        <a href="/panduan/cara-buat-laporan-polis-kes-ah-long" class="bg-gray-900/60 backdrop-blur-md p-6 rounded-lg border border-gray-700/50 hover:border-yellow-500/50 transition-all duration-300 group block">
            <div class="flex items-start justify-between">
                <div class="flex items-start">
                    <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded bg-black border border-gray-700 text-yellow-500 text-xs font-bold mr-4 group-hover:border-yellow-500 transition-colors">4</div>
                    <div>
                        <p class="text-gray-300 text-sm group-hover:text-white transition-colors pt-1">
                            Khidmat nasihat berkaitan <span class="text-white font-bold block mt-1">Hak & Perlindungan Pengguna</span>
                        </p>
                        <span class="inline-flex items-center text-xs text-yellow-500/80 group-hover:text-yellow-400 mt-2 font-medium">
                            Panduan Laporan Polis PDRM &rarr;
                        </span>
                    </div>
                </div>
            </div>
        </a>

    </div>

    <div class="mt-12 max-w-2xl mx-auto">
      <div class="p-4 bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 border-t border-b border-gray-800 rounded-lg">
        <p class="text-gray-400 italic text-xs tracking-wide">
          "Sekiranya anda memerlukan khidmat nasihat atau bantuan lanjut, sila hubungi Team Email Rakyat untuk membuat temu janji."
        </p>
      </div>
    </div>

  </div>
</section>
<section class="relative bg-zinc-900 py-16 md:py-24 overflow-hidden border-b border-gray-800">
  <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-yellow-500/50 to-transparent opacity-50"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-12">
          <h2 class="text-3xl md:text-5xl font-black text-white uppercase tracking-tight mb-6 drop-shadow-lg">
              Apa Itu <span class="text-yellow-500">Advokasi?</span>
          </h2>
          <p class="text-gray-300 text-lg md:text-xl leading-relaxed max-w-3xl mx-auto font-light">
            Advokasi ialah tindakan menjadi suara kepada pihak yang lemah atau teraniaya, terutamanya apabila mereka:
          </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-3xl mx-auto">
          <div class="flex items-center p-4 bg-black/40 border border-gray-700/50 rounded-lg hover:border-yellow-500/40 transition-colors duration-300">
              <div class="flex-shrink-0 mr-4 text-yellow-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
              </div>
              <span class="text-gray-200 font-medium text-lg">Tidak Tahu Prosedur</span>
          </div>

          <div class="flex items-center p-4 bg-black/40 border border-gray-700/50 rounded-lg hover:border-yellow-500/40 transition-colors duration-300">
              <div class="flex-shrink-0 mr-4 text-yellow-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
                  </svg>
              </div>
              <span class="text-gray-200 font-medium text-lg">Takut Bersuara</span>
          </div>

          <div class="flex items-center p-4 bg-black/40 border border-gray-700/50 rounded-lg hover:border-yellow-500/40 transition-colors duration-300">
              <div class="flex-shrink-0 mr-4 text-yellow-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V17m0 16a3 3 0 1011-3603 3 3 0 100 0z" />
                  </svg>
              </div>
              <span class="text-gray-200 font-medium text-lg">Tidak Dilayan Secara Adil</span>
          </div>

          <div class="flex items-center p-4 bg-black/40 border border-gray-700/50 rounded-lg hover:border-yellow-500/40 transition-colors duration-300">
              <div class="flex-shrink-0 mr-4 text-yellow-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
              </div>
              <span class="text-gray-200 font-medium text-lg">Berdepan Penyalahgunaan Kuasa</span>
          </div>
      </div>
  </div>
</section>

<section class="bg-black py-16 md:py-24 border-b border-gray-800 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-12">
      <div class="inline-block px-3 py-1 mb-3 text-[10px] font-bold tracking-wider text-red-400 uppercase bg-red-500/10 rounded-full border border-red-500/20">
        Panduan Kecemasan Mangsa
      </div>
      <h2 class="text-2xl sm:text-4xl font-black text-white uppercase tracking-tight mb-4">
        Ah Long Ugut Atau Kacau Anda? <span class="text-yellow-500 block text-lg sm:text-2xl font-bold mt-1">Langkah Segera Selesaikan Kes Ah Long di Malaysia</span>
      </h2>
      <p class="text-gray-400 text-sm md:text-base max-w-3xl mx-auto leading-relaxed">
        Jangan biarkan sindiket mengawal hidup anda. Ketahui hak anda di sisi undang-undang dan cara selamat keluar daripada perangkap pinjaman haram.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-gray-900/70 border border-gray-800 hover:border-yellow-500/50 rounded-2xl p-6 transition-all duration-300 group flex flex-col justify-between">
        <div>
          <span class="text-xs font-black tracking-widest text-yellow-500 uppercase">Soalan Asas</span>
          <h3 class="text-lg font-bold text-white mt-2 mb-3 group-hover:text-yellow-400 transition-colors">
            Apa Itu Ah Long? <br><span class="text-xs text-gray-400 font-normal">(What is Ah Long)</span>
          </h3>
          <p class="text-gray-400 text-xs leading-relaxed">
            Ah Long adalah peminjam wang haram tanpa lesen sah (Akta Pemberi Pinjam Wang 1951). Mereka mengenakan bunga harian melampau, pegang kad ATM atau salinan IC, dan menggunakan taktik ugutan apabila mangsa tidak mampu bayar.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-gray-800 text-[11px] text-yellow-500 font-medium">
          Status: Pinjaman Haram / Batal
        </div>
      </div>

      <div class="bg-gray-900/70 border border-gray-800 hover:border-red-500/50 rounded-2xl p-6 transition-all duration-300 group flex flex-col justify-between">
        <div>
          <span class="text-xs font-black tracking-widest text-red-400 uppercase">Ugutan Jenayah</span>
          <h3 class="text-lg font-bold text-white mt-2 mb-3 group-hover:text-red-400 transition-colors">
            Ah Long Ugut Saya <br><span class="text-xs text-gray-400 font-normal">(Ahlong threatening me)</span>
          </h3>
          <p class="text-gray-400 text-xs leading-relaxed">
            Sindiket ugut sebar gambar IC, aib di WhatsApp kenalan telefon, atau ugut bakar rumah dan ugut bunuh? Ini kesalahan jenayah Seksyen 503/506 Kanun Keseksaan. Jangan bayar wang ugutan — kumpul bukti untuk tindakan laporan polis rasmi.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-gray-800 text-[11px] text-red-400 font-medium">
          Tindakan: Seksyen 506 Kanun Keseksaan
        </div>
      </div>

      <div class="bg-gray-900/70 border border-gray-800 hover:border-yellow-500/50 rounded-2xl p-6 transition-all duration-300 group flex flex-col justify-between">
        <div>
          <span class="text-xs font-black tracking-widest text-yellow-500 uppercase">Gangguan Fizikal & Kerja</span>
          <h3 class="text-lg font-bold text-white mt-2 mb-3 group-hover:text-yellow-400 transition-colors">
            Ah Long Kacau Saya <br><span class="text-xs text-gray-400 font-normal">(Ahlong is harassing me)</span>
          </h3>
          <p class="text-gray-400 text-xs leading-relaxed">
            Diserang dengan simbah cat merah di pintu pagar, rantai kunci pintu rumah, atau kacau tempat kerja dan hubungi bos? Kami bimbing mangsa buat laporan teknikal untuk buka Kertas Siasatan (IP) dan hentikan gangguan serta-merta.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-gray-800 text-[11px] text-gray-400 font-medium">
          Tindakan: Seksyen 427 (Khianat Harta)
        </div>
      </div>

      <div class="bg-gray-900/70 border border-gray-800 hover:border-green-500/50 rounded-2xl p-6 transition-all duration-300 group flex flex-col justify-between">
        <div>
          <span class="text-xs font-black tracking-widest text-green-400 uppercase">Penyelesaian Sah</span>
          <h3 class="text-lg font-bold text-white mt-2 mb-3 group-hover:text-green-400 transition-colors">
            Kes Ah Long Malaysia <br><span class="text-xs text-gray-400 font-normal">(Bayar Pokok Sahaja)</span>
          </h3>
          <p class="text-gray-400 text-xs leading-relaxed">
            Terperangkap bayar bunga berganda tanpa habis? Kadar bunga haram tidak sah di mahkamah. Ramai mangsa berjaya selesai dengan menghentikan bunga dan hanya menjelaskan baki modal pokok pinjaman secara berstruktur dan sah.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-gray-800 text-[11px] text-green-400 font-medium">
          Solusi: Henti Bunga / Selesai Modal Pokok
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-2">
      <span class="text-xs text-gray-500 mr-2">Carian Bantuan:</span>
      <span class="px-3 py-1 rounded-full text-[11px] bg-zinc-900 border border-gray-800 text-gray-300">#AhLongUgutSaya</span>
      <span class="px-3 py-1 rounded-full text-[11px] bg-zinc-900 border border-gray-800 text-gray-300">#AhLongKacauSaya</span>
      <span class="px-3 py-1 rounded-full text-[11px] bg-zinc-900 border border-gray-800 text-gray-300">#AhlongCasesMalaysia</span>
      <span class="px-3 py-1 rounded-full text-[11px] bg-zinc-900 border border-gray-800 text-gray-300">#AhlongIsHarassingMe</span>
      <span class="px-3 py-1 rounded-full text-[11px] bg-zinc-900 border border-gray-800 text-gray-300">#WhatIsAhlong</span>
      <span class="px-3 py-1 rounded-full text-[11px] bg-zinc-900 border border-gray-800 text-gray-300">#SimbahCatMerah</span>
      <span class="px-3 py-1 rounded-full text-[11px] bg-zinc-900 border border-gray-800 text-gray-300">#BayarPokokSahaja</span>
    </div>
  </div>
</section>