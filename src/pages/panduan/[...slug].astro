---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const panduanEntries = await getCollection('panduan');
  return panduanEntries.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;

const baseUrl = Astro.site ? Astro.site.origin : 'https://e-rakyat.com';
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).href;
const ogImage = new URL(data.image || '/logo.png', baseUrl).href;

const formattedPublishDate = new Intl.DateTimeFormat('ms-MY', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(data.publishDate);

const formattedUpdateDate = data.updatedDate
  ? new Intl.DateTimeFormat('ms-MY', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    }).format(data.updatedDate)
  : null;

// JSON-LD Structured Data for YMYL Google Compliance
const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${baseUrl}/#website`,
        "name": "Email Rakyat",
        "url": baseUrl
      },
      "headline": data.metaTitle || data.title,
      "description": data.description,
      "inLanguage": "ms-MY",
      "mainEntityOfPage": canonicalUrl,
      "datePublished": data.publishDate.toISOString(),
      "dateModified": (data.updatedDate || data.publishDate).toISOString(),
      "author": {
        "@type": "Organization",
        "name": data.author,
        "url": baseUrl
      },
      "publisher": {
        "@type": "Organization",
        "name": "The ER Advocacy Sdn. Bhd.",
        "url": baseUrl,
        "logo": {
          "@type": "ImageObject",
          "url": `${baseUrl}/logo.png`
        }
      },
      "image": ogImage,
      "keywords": data.keywords.join(", ")
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Utama",
          "item": baseUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Panduan & Advokasi",
          "item": `${baseUrl}/panduan`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": data.title,
          "item": canonicalUrl
        }
      ]
    },
    ...(data.faqs && data.faqs.length > 0
      ? [
          {
            "@type": "FAQPage",
            "@id": `${canonicalUrl}#faq`,
            "mainEntity": data.faqs.map((faq) => ({
              "@type": "@Question",
              "name": faq.question,
              "acceptedAnswer": {
                "@type": "Answer",
                "text": faq.answer
              }
            }))
          }
        ]
      : [])
  ]
};
---

<Layout
  title={data.metaTitle || data.title}
  description={data.description}
>
  <Fragment slot="head">
    <meta name="keywords" content={data.keywords.join(", ")} />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={data.publishDate.toISOString()} />
    {data.updatedDate && (
      <meta property="article:modified_time" content={data.updatedDate.toISOString()} />
    )}
    <meta property="article:section" content={data.category} />
    {data.keywords.map((kw) => (
      <meta property="article:tag" content={kw} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
  </Fragment>

  <div class="w-full bg-black text-gray-200 pt-28 sm:pt-32 md:pt-36 pb-28 selection:bg-yellow-500 selection:text-black">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Urgent Hotline Alert Box (Clear spacing below fixed Navbar) -->
      <aside aria-label="Talian Kecemasan" class="mb-8 p-3.5 sm:p-4 rounded-2xl bg-red-950/70 border border-red-500/40 shadow-lg backdrop-blur-md">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
          <div class="flex items-center gap-2.5">
            <span class="flex h-2.5 w-2.5 relative shrink-0">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500"></span>
            </span>
            <p class="text-xs sm:text-sm font-semibold text-red-200 leading-snug">
              Sedang diugut atau diserang Ah Long sekarang? Jangan panik & jangan terus bayar bunga ugutan.
            </p>
          </div>
          <a
            href="https://WaiYanTeamEmailRakyat.wasap.my"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-full bg-red-600 hover:bg-red-500 text-white text-xs font-black uppercase tracking-wider transition-all shrink-0 w-full sm:w-auto"
          >
            <span>WhatsApp Kecemasan</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </aside>

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-1.5 text-xs text-gray-400">
        <a href="/" class="hover:text-yellow-400 transition-colors">Utama</a>
        <span>/</span>
        <a href="/panduan" class="hover:text-yellow-400 transition-colors">Panduan</a>
        <span>/</span>
        <span class="text-yellow-500 truncate max-w-[200px] sm:max-w-md">{data.title}</span>
      </nav>

      <!-- Header Section -->
      <header class="mb-10 sm:mb-12 border-b border-gray-800 pb-8 sm:pb-10">
        <div class="flex flex-wrap items-center gap-2.5 mb-4">
          <span class="px-3 py-1 rounded-full bg-yellow-500/10 border border-yellow-500/30 text-yellow-400 text-[10px] sm:text-xs font-black uppercase tracking-wider">
            {data.badge}
          </span>
          <span class="px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-gray-400 text-[10px] sm:text-xs font-medium">
            {data.category}
          </span>
          <span class="text-[11px] sm:text-xs text-gray-500">
            ⏱ {data.readTime}
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black text-white leading-tight tracking-tight mb-5 sm:mb-6">
          {data.title}
        </h1>

        <p class="text-sm sm:text-base md:text-lg text-gray-300 leading-relaxed max-w-4xl font-normal mb-6 sm:mb-8">
          {data.description}
        </p>

        <!-- E-E-A-T Author Card -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-2xl bg-zinc-900/60 border border-zinc-800 backdrop-blur-sm">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-yellow-500/20 border border-yellow-500/40 flex items-center justify-center text-yellow-400 font-black text-sm shrink-0">
              ER
            </div>
            <div>
              <p class="text-xs font-bold text-white uppercase tracking-wider">{data.author}</p>
              <p class="text-[11px] text-gray-400">{data.authorRole}</p>
            </div>
          </div>
          <div class="text-[11px] text-gray-400 flex flex-col sm:items-end border-t sm:border-t-0 border-zinc-800/80 pt-2 sm:pt-0">
            <span>Diterbitkan: <strong class="text-gray-300">{formattedPublishDate}</strong></span>
            {formattedUpdateDate && (
              <span>Dikemas kini: <strong class="text-yellow-400">{formattedUpdateDate}</strong></span>
            )}
          </div>
        </div>
      </header>

      <!-- Mobile Quick TOC Accordion (< lg only) -->
      {headings && headings.length > 0 && (
        <details class="lg:hidden mb-8 p-4 rounded-2xl bg-zinc-900/90 border border-zinc-800 open:border-yellow-500/40">
          <summary class="flex items-center justify-between cursor-pointer list-none font-bold text-xs uppercase tracking-wider text-yellow-400">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
              Lompat Ke Bahagian Panduan ({headings.filter(h => h.depth <= 3).length})
            </span>
            <svg class="w-4 h-4 text-gray-400 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <nav class="mt-3 pt-3 border-t border-zinc-800 space-y-2 text-xs">
            {headings
              .filter((h) => h.depth <= 3)
              .map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class={`block transition-colors hover:text-yellow-400 py-0.5 ${
                    heading.depth === 2
                      ? 'font-bold text-gray-200 pl-0'
                      : 'text-gray-400 pl-3 border-l border-zinc-700 hover:border-yellow-500'
                  }`}
                >
                  {heading.text}
                </a>
              ))}
          </nav>
        </details>
      )}

      <!-- Grid Layout: Article on Left (8 cols) + Sticky Sidebar on Right (4 cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        <!-- Main Article Body -->
        <article class="lg:col-span-8 w-full min-w-0 pillar-article no-reveal">

          <!-- Law Sections Quick Highlight (Interactive Cards) -->
          {data.lawSections && data.lawSections.length > 0 && (
            <section class="mb-10 sm:mb-12 p-5 sm:p-7 md:p-8 rounded-3xl bg-zinc-900/90 border border-yellow-500/30 shadow-2xl">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-yellow-500 text-lg">⚖️</span>
                <span class="text-[10px] sm:text-xs font-black uppercase tracking-widest text-yellow-500">
                  Perisai Statut Perundangan Malaysia
                </span>
              </div>
              <h2 class="text-lg sm:text-xl md:text-2xl font-black text-white mb-5 sm:mb-6">
                Seksyen Undang-Undang Yang Melindungi Mangsa Ah Long
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4">
                {data.lawSections.map((law) => (
                  <div class="p-4 rounded-xl bg-black/60 border border-zinc-800 hover:border-yellow-500/40 transition-colors flex flex-col justify-between">
                    <div>
                      <p class="text-[10px] font-black uppercase tracking-wider text-yellow-400 mb-1">
                        {law.section}
                      </p>
                      <h3 class="text-xs sm:text-sm font-bold text-white mb-1.5 leading-snug">
                        {law.title}
                      </h3>
                      <p class="text-xs text-gray-400 leading-relaxed mb-3">
                        {law.description}
                      </p>
                    </div>
                    <div class="pt-2 border-t border-zinc-800/80 text-[10px] text-red-400 font-semibold leading-tight">
                      Hukuman: {law.legalPenalty}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Markdown Content Body with Pillar Custom Typography -->
          <div class="pillar-content break-words">
            <Content />
          </div>

          <!-- FAQ Accordion (Rendered from Zod Schema) -->
          {data.faqs && data.faqs.length > 0 && (
            <section class="mt-14 sm:mt-16 pt-10 sm:pt-12 border-t border-gray-800">
              <div class="mb-6 sm:mb-8">
                <span class="text-[10px] font-black tracking-widest uppercase text-yellow-500 bg-yellow-500/10 px-3 py-1 rounded-full border border-yellow-500/20">
                  Soalan Lazim Berkanun
                </span>
                <h2 class="text-xl sm:text-2xl md:text-3xl font-black text-white mt-3 mb-2">
                  Soalan Kerap Ditanya Mengenai Tindakan Undang-Undang
                </h2>
                <p class="text-xs sm:text-sm text-gray-400">
                  Jawapan rasmi dan bimbingan keselamatan berlandaskan statut undang-undang jenayah Malaysia.
                </p>
              </div>

              <div class="space-y-3.5 sm:space-y-4">
                {data.faqs.map((faq, idx) => (
                  <details class="group p-4 sm:p-5 rounded-2xl bg-zinc-900/70 border border-zinc-800 open:border-yellow-500/50 open:bg-zinc-900 transition-all">
                    <summary class="flex justify-between items-center cursor-pointer list-none font-bold text-xs sm:text-sm md:text-base text-white group-hover:text-yellow-400 transition-colors">
                      <span class="flex items-start gap-2.5 sm:gap-3 pr-4">
                        <span class="text-yellow-500 font-mono text-xs sm:text-sm mt-0.5">{String(idx + 1).padStart(2, '0')}.</span>
                        <span>{faq.question}</span>
                      </span>
                      <svg class="w-4 h-4 sm:w-5 sm:h-5 text-yellow-500 transition-transform duration-300 group-open:rotate-180 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </summary>
                    <div class="mt-3 pt-3 border-t border-zinc-800 text-xs sm:text-sm text-gray-300 leading-relaxed pl-5 sm:pl-7">
                      <p>{faq.answer}</p>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )}

          <!-- Bottom Help CTA Card -->
          <footer class="mt-14 sm:mt-16 p-6 sm:p-8 md:p-10 rounded-3xl bg-gradient-to-r from-zinc-950 via-zinc-900 to-zinc-950 border border-yellow-500/30 text-center">
            <h2 class="text-xl sm:text-2xl font-black text-white mb-3">
              Jangan Tanggung Ketakutan Ini Bersendirian
            </h2>
            <p class="text-xs sm:text-sm text-gray-400 max-w-xl mx-auto mb-6 leading-relaxed">
              Pegawai advokasi ER Advocacy sedia membimbing anda menyusun kronologi fakta kes dan laporan polis teknikal untuk menghentikan pemerasan serta-merta.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a
                href="https://WaiYanTeamEmailRakyat.wasap.my"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full sm:w-auto items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-yellow-500 hover:bg-yellow-400 text-black font-black text-xs uppercase tracking-wider shadow-xl transition-all"
              >
                <span>Dapatkan Bantuan Sulit Sekarang</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
              <a
                href="/hubungi"
                class="inline-flex w-full sm:w-auto items-center justify-center px-7 py-3.5 rounded-full border border-zinc-700 hover:border-yellow-500 text-gray-200 hover:text-white font-bold text-xs uppercase tracking-wider transition-all"
              >
                Borang Temu Janji Rasmi
              </a>
            </div>
          </footer>

        </article>

        <!-- Desktop Sidebar (TOC + Action Box) -->
        <aside class="lg:col-span-4 w-full space-y-6">
          <div class="sticky top-28 space-y-6">

            <!-- Desktop Table of Contents -->
            {headings && headings.length > 0 && (
              <div class="hidden lg:block p-6 rounded-2xl bg-zinc-900/80 border border-zinc-800 backdrop-blur-md">
                <h2 class="text-xs font-black uppercase tracking-wider text-yellow-400 mb-4 flex items-center gap-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                  Isi Kandungan Panduan
                </h2>
                <nav class="space-y-2 text-xs max-h-[50vh] overflow-y-auto pr-2">
                  {headings
                    .filter((h) => h.depth <= 3)
                    .map((heading) => (
                      <a
                        href={`#${heading.slug}`}
                        class={`block transition-colors hover:text-yellow-400 ${
                          heading.depth === 2
                            ? 'font-bold text-gray-200 pl-0 py-0.5'
                            : 'text-gray-400 pl-3 border-l border-zinc-700 hover:border-yellow-500 py-0.5'
                        }`}
                      >
                        {heading.text}
                      </a>
                    ))}
                </nav>
              </div>
            )}

            <!-- Quick Action Box -->
            <div class="p-5 sm:p-6 rounded-2xl bg-gradient-to-b from-yellow-500/10 via-zinc-900/90 to-zinc-950 border border-yellow-500/30 text-center">
              <span class="inline-block px-2.5 py-0.5 rounded bg-yellow-500/20 text-yellow-400 font-bold text-[10px] uppercase tracking-widest mb-2">
                Bantuan Percuma
              </span>
              <h3 class="text-sm sm:text-base font-bold text-white mb-2">
                Perlukan Semakan Kes Anda?
              </h3>
              <p class="text-xs text-gray-400 mb-4 leading-relaxed">
                Hantar bukti ugutan WhatsApp dan transaksi kepada pegawai bertugas kami untuk semakan liabiliti secara percuma & sulit.
              </p>
              <a
                href="https://WaiYanTeamEmailRakyat.wasap.my"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full items-center justify-center gap-2 py-3 px-4 rounded-xl bg-yellow-500 hover:bg-yellow-400 text-black font-black text-xs uppercase tracking-wider shadow-lg transition-all"
              >
                <span>Hubungi Pegawai Bertugas</span>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.405c-.003 6.558-5.338 11.893-11.893 11.893h-.005a11.88 11.88 0 01-5.683-1.448L.057 24z"/></svg>
              </a>
            </div>

          </div>
        </aside>

      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* Ensure article and pillar content are never hidden by scroll observers */
  .pillar-article,
  .pillar-content,
  .pillar-content *,
  .no-reveal,
  .no-reveal * {
    opacity: 1 !important;
    transform: none !important;
    visibility: visible !important;
  }

  /* Clear fixed navbar on anchor jump */
  html {
    scroll-padding-top: 6.5rem;
    scroll-behavior: smooth;
  }

  .pillar-content [id],
  .pillar-article [id],
  h2[id],
  h3[id],
  section[id] {
    scroll-margin-top: 7rem !important;
  }

  /* Rich Pillar Typography Styling */
  .pillar-content h1 {
    display: none; /* Already rendered in page header */
  }

  .pillar-content h2 {
    font-size: 1.35rem;
    font-weight: 900;
    color: #ffffff;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(234, 179, 8, 0.2);
  }

  @media (min-width: 640px) {
    .pillar-content h2 {
      font-size: 1.75rem;
      margin-top: 2.75rem;
    }
  }

  .pillar-content h3 {
    font-size: 1.1rem;
    font-weight: 800;
    color: #facc15;
    margin-top: 1.75rem;
    margin-bottom: 0.65rem;
    line-height: 1.35;
  }

  @media (min-width: 640px) {
    .pillar-content h3 {
      font-size: 1.25rem;
    }
  }

  .pillar-content p {
    font-size: 0.925rem;
    color: #d1d5db;
    line-height: 1.8;
    margin-bottom: 1.15rem;
  }

  @media (min-width: 640px) {
    .pillar-content p {
      font-size: 0.975rem;
    }
  }

  .pillar-content blockquote {
    border-left: 4px solid #eab308;
    background: rgba(24, 24, 27, 0.85);
    padding: 1rem 1.15rem;
    border-radius: 0 0.75rem 0.75rem 0;
    margin: 1.35rem 0;
    color: #f3f4f6;
  }

  .pillar-content blockquote p {
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .pillar-content blockquote p:last-child {
    margin-bottom: 0;
  }

  .pillar-content ul, .pillar-content ol {
    margin: 1.15rem 0;
    padding-left: 1.25rem;
    color: #d1d5db;
  }

  .pillar-content ul {
    list-style-type: disc;
  }

  .pillar-content ol {
    list-style-type: decimal;
  }

  .pillar-content li {
    margin-bottom: 0.5rem;
    line-height: 1.65;
    font-size: 0.9rem;
  }

  @media (min-width: 640px) {
    .pillar-content li {
      font-size: 0.95rem;
    }
  }

  .pillar-content strong {
    color: #ffffff;
    font-weight: 700;
  }

  .pillar-content hr {
    border: 0;
    border-top: 1px solid #27272a;
    margin: 2.25rem 0;
  }
</style>
