---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { Image } from "astro:assets";

import hubungiBg from "../assets/banner-hubungi.jpg";
import shazzImg from "../assets/shazz.webp";

const prepItems = [
  {
    num: "01",
    title: "Butiran Kes",
    desc: "Nama pihak terlibat, punca pinjaman, tempoh gangguan, dan sama ada melibatkan ceti haram (Ah Long), ejen kutipan hutang, atau syarikat kredit berlesen."
  },
  {
    num: "02",
    title: "Bukti Sokongan",
    desc: "Tangkap layar mesej WhatsApp, rakaman panggilan, nombor akaun bank pihak terlibat, resit transaksi bayaran, surat ugutan, atau bukti gangguan fizikal."
  },
  {
    num: "03",
    title: "Status Semasa",
    desc: "Maklumkan jika laporan polis telah dibuat, jika wujud ancaman fizikal secara langsung, atau jika anda memerlukan panduan teknikal untuk tindakan selanjutnya."
  }
];
---

<Layout
  title="Hubungi Talian Bantuan & Khidmat Nasihat Ah Long | Team Email Rakyat"
  description="Hubungi pegawai bertugas Team Email Rakyat segera untuk bantuan kecemasan gangguan Ah Long, ugutan debt collector, dan aduan salah laku kredit komuniti KPKT. Selesai masalah secara sah."
>
  <Hero
    line1="Hubungi Kami"
    line2="Talian Bantuan & Konsultasi Sulit"
    showDetails={false}
    backgroundImage={hubungiBg}
  />

  <main class="site-container py-16 md:py-24">
    <!-- Header -->
    <div class="max-w-3xl mb-16 md:mb-20">
      <span class="eyebrow eyebrow-accent mb-4">Saluran Perhubungan Rasmi</span>
      <h2 class="h-page mt-2 mb-6">Hubungi talian bantuan dan khidmat nasihat.</h2>
      <p class="lead">
        Sekiranya anda memerlukan bimbingan kecemasan atau ingin membuat temu
        janji konsultasi, sila hubungi pegawai bertugas kami. Segala maklumat
        dijamin sulit.
      </p>
    </div>

    <!-- Contact Directory: Clean 2-Column Split (Zero Outer Boxes) -->
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 border-t border-[var(--site-line)] pt-12 md:pt-16"
    >
      <!-- Officer in Charge -->
      <div class="md:col-span-7 space-y-8">
        <div>
          <span class="eyebrow mb-4">Pegawai Bertugas</span>
          <div class="flex items-center gap-4 mt-2">
            <Image
              src={shazzImg}
              alt="Puan Shazz Medley"
              class="w-16 h-16 rounded-full object-cover border border-[var(--site-line-strong)]"
            />
            <div>
              <h3
                class="text-xl md:text-2xl font-bold text-[var(--site-heading)] tracking-tight"
              >
                Puan Shazz Medley
              </h3>
              <p class="text-xs font-mono uppercase tracking-wider text-[var(--site-muted)] mt-0.5">
                Pengurus Pentadbiran
              </p>
            </div>
          </div>
        </div>

        <div
          class="border-y border-[var(--site-line)] divide-y divide-[var(--site-line)]"
        >
          <!-- WhatsApp Link -->
          <a
            href="https://WaiYanTeamEmailRakyat.wasap.my"
            target="_blank"
            rel="noopener noreferrer"
            onclick="return gtag_report_conversion('https://WaiYanTeamEmailRakyat.wasap.my');"
            class="editorial-row flex items-center justify-between py-6 transition-colors group"
          >
            <div>
              <span
                class="text-xs font-mono text-[var(--site-subtle)] uppercase tracking-wider block mb-1"
                >WhatsApp / Panggilan Rasmi</span
              >
              <span
                class="text-lg md:text-xl font-bold text-[var(--site-heading)] group-hover:text-[var(--site-accent)] transition-colors tracking-tight"
              >
                012-623 2949
              </span>
            </div>
            <span class="link-arrow text-xs"> Buka WhatsApp </span>
          </a>

          <!-- Email Link -->
          <a
            href="#"
            id="email-link"
            data-user="aduan"
            data-domain="e-rakyat.com"
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-row flex items-center justify-between py-6 transition-colors group"
          >
            <div>
              <span
                class="text-xs font-mono text-[var(--site-subtle)] uppercase tracking-wider block mb-1"
                >E-Mel Pertanyaan Rasmi</span
              >
              <span
                id="email-display"
                class="text-lg md:text-xl font-bold text-[var(--site-heading)] group-hover:text-[var(--site-accent)] transition-colors break-all tracking-tight"
              >
                Klik untuk paparkan emel
              </span>
            </div>
            <span class="link-arrow text-xs"> Hantar E-Mel </span>
          </a>

          <script is:inline>
            (function () {
              var link = document.getElementById("email-link");
              if (!link) return;
              var display = document.getElementById("email-display");
              var revealed = false;
              function reveal() {
                if (revealed) return;
                revealed = true;
                var email = link.dataset.user + "\u0040" + link.dataset.domain;
                if (display) display.textContent = email;
                link.setAttribute(
                  "href",
                  "https://mail.google.com/mail/?view=cm&fs=1&to=" +
                    encodeURIComponent(email),
                );
              }
              link.addEventListener("mouseenter", reveal);
              link.addEventListener("focus", reveal);
              link.addEventListener("touchstart", reveal, { passive: true });
              link.addEventListener("click", reveal);
            })();
          </script>
        </div>
      </div>

      <!-- Schedule & Operations -->
      <div
        class="md:col-span-5 border-t md:border-t-0 md:border-l border-[var(--site-line)] pt-8 md:pt-0 md:pl-10 space-y-6"
      >
        <div>
          <span class="eyebrow mb-3">Jadual Operasi</span>
          <h3 class="text-xl font-bold text-[var(--site-heading)] tracking-tight mt-2 mb-5">
            Waktu Pejabat &amp; Konsultasi
          </h3>
          <dl class="divide-y divide-[var(--site-line)] border-y border-[var(--site-line)] text-sm">
            <div class="py-3.5 flex justify-between items-baseline gap-4">
              <dt class="text-[var(--site-subtle)] text-xs font-mono uppercase">
                Hari Bertugas
              </dt>
              <dd class="text-[var(--site-heading)] font-bold text-right">
                Selasa hingga Ahad
              </dd>
            </div>
            <div class="py-3.5 flex justify-between items-baseline gap-4">
              <dt class="text-[var(--site-subtle)] text-xs font-mono uppercase">
                Waktu Operasi
              </dt>
              <dd class="text-[var(--site-heading)] font-bold text-right">
                10:00 Pagi – 6:00 Petang
              </dd>
            </div>
            <div class="py-3.5 flex justify-between items-baseline gap-4">
              <dt class="text-[var(--site-subtle)] text-xs font-mono uppercase">
                Hari Cuti
              </dt>
              <dd class="text-[var(--site-muted)] text-right">Setiap hari Isnin</dd>
            </div>
          </dl>
        </div>

        <div class="border-l-2 border-[var(--site-accent)] pl-4 py-1 text-xs text-[var(--site-muted)] leading-relaxed">
          Sesi bersemuka hanya melalui temu janji awal bagi memastikan pegawai
          penyiasat berkaitan bersedia mengkaji fail anda.
        </div>
      </div>
    </div>

    <!-- Preparation Checklist: Clean Divided Rows (Zero Boxes/Grids) -->
    <section class="site-section mt-16 md:mt-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-5 lg:sticky lg:top-28">
          <span class="eyebrow eyebrow-accent mb-3">Panduan Persediaan</span>
          <h2 class="h-section mt-2 mb-4">Sebelum Menghubungi Kami</h2>
          <p class="lead">
            Sediakan butiran ringkas ini bagi memudahkan kami menilai fakta
            kes anda dengan cepat dan tepat.
          </p>
        </div>

        <div class="lg:col-span-7 border-y border-[var(--site-line)] divide-y divide-[var(--site-line)]">
          {prepItems.map((item) => (
            <div class="editorial-row py-8 flex flex-col sm:flex-row sm:items-baseline gap-3 sm:gap-8">
              <span class="text-xs font-mono font-bold text-[var(--site-accent)] tracking-widest shrink-0">
                {item.num} / DOKUMEN
              </span>
              <div>
                <h3 class="text-lg md:text-xl font-bold mb-2 text-[var(--site-heading)] tracking-tight">
                  {item.title}
                </h3>
                <p class="body-text text-sm md:text-base leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Security Footnote -->
    <div class="pt-12 text-center border-t border-[var(--site-line)]">
      <p
        class="text-xs font-mono text-[var(--site-subtle)] uppercase tracking-wider"
      >
        Komunikasi dan fail pengadu dilindungi di bawah protokol perlindungan
        kerahsiaan peribadi.
      </p>
    </div>
  </main>
</Layout>
