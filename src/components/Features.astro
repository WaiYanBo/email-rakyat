---
const focusAreas = [
  {
    num: "01",
    title: "Mangsa Pinjaman Tanpa Lesen (Ah Long)",
    desc: "Bantuan menghentikan ugutan harian, perang psikologi, dan menguruskan penyelesaian bayar pokok sahaja secara sah.",
    href: "/panduan/cara-selesaikan-hutang-ah-long-bayar-pokok",
    linkText: "Panduan bayar pokok"
  },
  {
    num: "02",
    title: "Gangguan Pengutip Hutang (Debt Collector)",
    desc: "Perlindungan terhadap taktik kasar, pencerobohan privasi, serta rundingan penyelesaian penuh bagi hutang lapuk.",
    href: "/panduan/hak-peminjam-gangguan-debt-collector-malaysia",
    linkText: "Hak & had masa hutang"
  },
  {
    num: "03",
    title: "Salah Laku Syarikat Kredit Komuniti",
    desc: "Menangani isu faedah melampau, tahan kad ATM atau penyelewengan perjanjian kredit berlesen melalui saluran KPKT.",
    href: "/panduan/aduan-kredit-komuniti-kpkt-bunga-tinggi",
    linkText: "Prosedur aduan KPKT"
  },
  {
    num: "04",
    title: "Hak & Perlindungan Pengguna Sah",
    desc: "Penyusunan fakta kronologi dan dokumentasi teknikal bagi laporan polis rasmi di bawah peruntukan kanun statut negara.",
    href: "/panduan/cara-buat-laporan-polis-kes-ah-long",
    linkText: "Prosedur laporan polis"
  }
];

const principles = [
  {
    title: "Audit Transaksi & Kronologi",
    desc: "Kami menyemak perbezaan sebenar antara modal pokok yang diterima berbanding jumlah bunga tidak sah yang telah dibayar."
  },
  {
    title: "Laporan Polis Teknikal",
    desc: "Membimbing mangsa merakamkan elemen jenayah spesifik (pemerasan, akaun keldai) bagi membolehkan pihak polis membuka kertas siasatan."
  },
  {
    title: "Notis Advokasi & Perlindungan",
    desc: "Menjadi benteng perantara rasmi agar sindiket menghentikan gangguan terus kepada mangsa, keluarga, dan majikan."
  },
  {
    title: "Penyelesaian Modal Pokok Sah",
    desc: "Memastikan pertikaian ditutup secara muktamad tanpa tuntutan berulang atau pemerasan berterusan."
  }
];

const legalFacts = [
  {
    statute: "Statut Akta 400",
    title: "Pinjaman Tanpa Lesen Adalah Batal",
    desc: "Di bawah Seksyen 15 Akta Pemberi Pinjam Wang 1951, kontrak pinjaman oleh pihak yang tidak berlesen adalah tidak sah dan tidak boleh dikuatkuasakan di mana-mana mahkamah sivil di Malaysia."
  },
  {
    statute: "Seksyen 506 Kanun Keseksaan",
    title: "Ugutan & Sebar Gambar Adalah Jenayah",
    desc: "Menyebarkan gambar IC, mengugut ahli keluarga, atau membuat ancaman fizikal merupakan kesalahan jenayah pemerasan. Jangan bayar wang ugutan; laporkan fakta jenayah ini secara rasmi."
  },
  {
    statute: "Seksyen 427 Kanun Keseksaan",
    title: "Simbah Cat Merah & Khianat Harta",
    desc: "Perbuatan merosakkan pagar rumah, mengunci pintu, atau menyimbah cat merah membolehkan pihak polis membuka kertas siasatan bagi memburu sindiket atau runner upahan."
  },
  {
    statute: "Prinsip Keadilan Sah",
    title: "Selesai Secara Bayar Pokok Sahaja",
    desc: "Kadar bunga haram yang mencekik darah tidak diiktiraf statut. Ramai mangsa berjaya menamatkan pertikaian dengan hanya melangsaikan baki modal pokok bersih yang diterima."
  }
];
---

<!-- Section 1: Focus Areas (Clean Divided List, Zero Boxes) -->
<section class="site-section bg-[var(--site-bg)]">
  <div class="site-container">
    <div class="max-w-2xl mb-14 md:mb-16">
      <span class="eyebrow mb-3">Bidang Bantuan</span>
      <h2 class="h-section mt-2">
        Bimbingan Profesional &amp; Berlandaskan Undang-Undang.
      </h2>
      <p class="lead mt-4">
        Kami menyediakan khidmat nasihat swasta bagi membantu masyarakat menyelesaikan pertikaian pinjaman haram dan perlindungan hak pengguna.
      </p>
    </div>

    <div class="list-divided border-y border-[var(--site-line)]">
      {focusAreas.map((item) => (
        <article class="editorial-row group py-8 md:py-10 flex flex-col md:flex-row md:items-baseline justify-between gap-4 md:gap-8">
          <div class="flex items-baseline gap-6 md:w-5/12">
            <span class="font-mono text-sm font-bold text-[var(--site-accent)] tracking-widest shrink-0">
              {item.num}
            </span>
            <h3 class="text-lg md:text-xl font-bold text-[var(--site-heading)] group-hover:text-[var(--site-accent)] transition-colors tracking-tight">
              <a href={item.href}>{item.title}</a>
            </h3>
          </div>

          <p class="body-text text-sm md:text-base md:w-5/12">
            {item.desc}
          </p>

          <div class="md:w-2/12 md:text-right pt-2 md:pt-0">
            <a href={item.href} class="link-arrow text-sm">
              {item.linkText}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Section 2: Principles & Philosophy (Editorial Split, Zero Boxes) -->
<section class="site-section bg-[var(--site-surface)]">
  <div class="site-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <span class="eyebrow mb-3">Pendekatan Kami</span>
        <h2 class="h-section mt-2 mb-6">
          Advokasi Tegas, Bebas Dari Suapan &amp; Kompromi.
        </h2>
        <p class="body-text text-base leading-relaxed mb-8">
          Ramai mangsa terperangkap kerana takut bersuara atau tidak memahami tatakelola undang-undang. Kami bertindak sebagai penasihat bebas untuk mengembalikan ketenteraman hidup anda tanpa jalan pintas yang merugikan.
        </p>
        <div class="border-l-2 border-[var(--site-accent)] pl-5 py-1">
          <p class="meta text-xs md:text-sm leading-relaxed text-[var(--site-muted)]">
            Perkhidmatan kami tertakluk kepada etika kerahsiaan maklumat peribadi dan tidak melibatkan sebarang pinjaman baharu bagi pihak anda.
          </p>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="list-divided border-y border-[var(--site-line)]">
          {principles.map((p, idx) => (
            <div class="editorial-row py-8 flex gap-6 items-baseline">
              <span class="font-mono text-sm font-bold text-[var(--site-accent)] tracking-widest shrink-0">
                0{idx + 1}
              </span>
              <div>
                <h3 class="text-lg font-bold text-[var(--site-heading)] tracking-tight mb-2">
                  {p.title}
                </h3>
                <p class="body-text text-sm md:text-base leading-relaxed">
                  {p.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Section 3: Legal Facts & Clarifications (Pure Editorial Divided Rows, Zero Boxes/Grids) -->
<section class="site-section bg-[var(--site-bg)]">
  <div class="site-container">
    <div class="max-w-2xl mb-14 md:mb-16">
      <span class="eyebrow mb-3">Fakta Undang-Undang</span>
      <h2 class="h-section mt-2">
        Hak Anda Di Sisi Undang-Undang Malaysia.
      </h2>
      <p class="lead mt-4">
        Ketahui asas perundangan penting sebelum membuat sebarang keputusan atau bayaran tambahan.
      </p>
    </div>

    <div class="list-divided border-y border-[var(--site-line)]">
      {legalFacts.map((fact) => (
        <article class="editorial-row py-8 md:py-10 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-baseline">
          <div class="md:col-span-3">
            <span class="font-mono text-xs font-bold text-[var(--site-accent)] uppercase tracking-widest">
              {fact.statute}
            </span>
          </div>
          <div class="md:col-span-4">
            <h3 class="text-lg md:text-xl font-bold text-[var(--site-heading)] tracking-tight">
              {fact.title}
            </h3>
          </div>
          <div class="md:col-span-5">
            <p class="body-text text-sm md:text-base leading-relaxed">
              {fact.desc}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
