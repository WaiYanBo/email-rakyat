---
const rawPath = new URL(Astro.request.url).pathname;
const pathname = rawPath.replace(/\/$/, "") || "/";

const navLinks = [
  { name: "Utama", path: "/" },
  { name: "Panduan", path: "/panduan" },
  { name: "Perkhidmatan", path: "/perkhidmatan" },
  { name: "Tentang", path: "/tentang" },
  { name: "Berita", path: "/berita" },
];
---

<header
  id="main-navbar"
  class="fixed w-full top-0 z-50 transition-all duration-300 navbar-at-top py-4 border-b border-transparent bg-transparent"
>
  <div class="site-container">
    <div class="flex justify-between items-center">
      <a href="/" class="flex-shrink-0 flex items-center gap-3 group">
        <img
          src="/Logo.webp"
          alt="Email Rakyat"
          width="44"
          height="44"
          decoding="async"
          class="h-9 sm:h-10 w-auto object-contain"
        />
        <div class="flex flex-col">
          <span
            class="brand-title text-[var(--site-heading)] font-extrabold text-base sm:text-lg tracking-tight leading-none transition-colors"
          >
            Email Rakyat
          </span>
          <span
            class="hidden sm:inline-block text-[10px] font-mono uppercase tracking-[0.16em] text-[var(--site-accent)] mt-1"
          >
            Advokasi Pengguna
          </span>
        </div>
      </a>

      <nav class="hidden md:flex space-x-7 items-center">
        {
          navLinks.map((link) => {
            const isActive =
              pathname === link.path ||
              pathname === "/" + link.path.replace("/", "") ||
              (link.path !== "/" && pathname.startsWith(link.path));
            return (
              <a
                href={link.path}
                class={`nav-link-item relative py-1 text-xs font-semibold tracking-wide transition-colors duration-200 ${
                  isActive
                    ? "nav-link-active text-[var(--site-accent)] font-bold"
                    : "text-[var(--site-muted)] hover:text-[var(--site-accent)]"
                }`}
              >
                {link.name}
                {isActive && (
                  <span class="absolute bottom-0 inset-x-0 h-0.5 rounded-full bg-[var(--site-accent)]" />
                )}
              </a>
            );
          })
        }

        <div
          class="flex items-center gap-3 pl-4 border-l border-[var(--site-line)]"
        >
          <button
            id="theme-toggle-desktop"
            type="button"
            aria-label="Tukar mod cerah atau gelap"
            class="p-2 rounded-lg text-[var(--site-muted)] hover:text-[var(--site-accent)] hover:bg-[var(--site-accent-subtle)] transition-colors focus:outline-none"
            title="Tukar mod cerah / gelap"
          >
            <svg
              class="w-4 h-4 theme-icon-sun"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
              ></path>
            </svg>
            <svg
              class="w-4 h-4 theme-icon-moon"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
              ></path>
            </svg>
          </button>

          <a
            href="/portal/login"
            class="portal-staff-link text-xs font-semibold text-[var(--site-subtle)] hover:text-[var(--site-heading)] transition-colors"
          >
            Portal Staff
          </a>

          <a href="/hubungi" class="btn-primary !py-2 !px-4 !text-xs">
            Hubungi Kami
          </a>
        </div>
      </nav>

      <div class="md:hidden flex items-center gap-1">
        <button
          id="theme-toggle-mobile"
          type="button"
          aria-label="Tukar mod cerah atau gelap"
          class="p-2 rounded-lg text-[var(--site-muted)] hover:text-[var(--site-accent)] transition-colors focus:outline-none"
          title="Tukar mod cerah / gelap"
        >
          <svg
            class="w-5 h-5 theme-icon-sun"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
            ></path>
          </svg>
          <svg
            class="w-5 h-5 theme-icon-moon"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
            ></path>
          </svg>
        </button>

        <button
          id="mobile-menu-btn"
          type="button"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Toggle Menu"
          class="text-[var(--site-muted)] hover:text-[var(--site-heading)] p-1.5 transition-colors"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.75"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden absolute top-full left-0 w-full bg-[var(--site-surface)] border-b border-[var(--site-line)] shadow-2xl max-h-[calc(100vh-4.5rem)] overflow-y-auto"
  >
    <div class="px-6 py-5 space-y-1">
      {
        navLinks.map((link) => (
          <a
            href={link.path}
            class={`block py-2.5 text-sm font-semibold transition-colors ${
              pathname === link.path ||
              pathname === "/" + link.path.replace("/", "")
                ? "text-[var(--site-accent)] font-bold"
                : "text-[var(--site-muted)] hover:text-[var(--site-accent)]"
            }`}
          >
            {link.name}
          </a>
        ))
      }

      <div
        class="border-t border-[var(--site-line)] pt-4 mt-3 flex flex-col gap-3"
      >
        <a
          href="/portal/login"
          class="text-sm font-semibold text-[var(--site-subtle)] hover:text-[var(--site-heading)] py-1"
        >
          Portal Staff
        </a>
        <a
          href="/hubungi"
          class="btn-primary w-full text-center !py-2.5 !text-sm"
        >
          Hubungi Kami
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navbar = document.getElementById("main-navbar");
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    if (!navbar || !mobileBtn || !mobileMenu) return;

    const toggleTheme = () => {
      const current =
        document.documentElement.getAttribute("data-theme") || "dark";
      const next = current === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      if (next === "light") {
        document.documentElement.classList.add("theme-light");
        document.documentElement.classList.remove("theme-dark");
      } else {
        document.documentElement.classList.add("theme-dark");
        document.documentElement.classList.remove("theme-light");
      }
      try {
        localStorage.setItem("public-theme", next);
      } catch (e) {}
    };

    const desktopToggle = document.getElementById("theme-toggle-desktop");
    if (desktopToggle) desktopToggle.addEventListener("click", toggleTheme);

    const mobileToggle = document.getElementById("theme-toggle-mobile");
    if (mobileToggle) mobileToggle.addEventListener("click", toggleTheme);

    const handleScroll = () => {
      const isScrolled = window.scrollY > 20;
      const isMobileOpen = !mobileMenu.classList.contains("hidden");

      if (isScrolled || isMobileOpen) {
        navbar.classList.add("navbar-scrolled", "shadow-sm", "py-2.5");
        navbar.classList.remove("navbar-at-top", "py-4");
      } else {
        navbar.classList.remove("navbar-scrolled", "shadow-sm", "py-2.5");
        navbar.classList.add("navbar-at-top", "py-4");
      }
    };

    handleScroll();

    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });

    const syncMobileMenuBodyScroll = () => {
      const isOpen =
        !mobileMenu.classList.contains("hidden") &&
        window.matchMedia("(max-width: 767px)").matches;
      document.body.style.overflow = isOpen ? "hidden" : "";
    };

    mobileBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      mobileMenu.classList.toggle("hidden");
      const expanded = !mobileMenu.classList.contains("hidden");
      mobileBtn.setAttribute("aria-expanded", expanded ? "true" : "false");
      handleScroll();
      syncMobileMenuBodyScroll();
    });

    window.addEventListener("resize", () => {
      if (window.matchMedia("(min-width: 768px)").matches) {
        document.body.style.overflow = "";
      } else {
        syncMobileMenuBodyScroll();
      }
      handleScroll();
    });

    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (
        !mobileMenu.classList.contains("hidden") &&
        !mobileMenu.contains(target) &&
        !mobileBtn.contains(target)
      ) {
        mobileMenu.classList.add("hidden");
        mobileBtn.setAttribute("aria-expanded", "false");
        handleScroll();
        syncMobileMenuBodyScroll();
      }
    });
  });
</script>
