---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import FAQ from "../components/FAQ.astro";
---

<Layout
  title="Bantuan Mangsa Ah Long: Ugutan, Simbah Cat & Sebar Gambar | Team Email Rakyat"
  description="Ah Long ugut saya? Ahlong is harassing or threatening me? Ketahui apa itu Ah Long, cara hadapi kes Ah Long di Malaysia, simbah cat, ugutan sebar gambar IC & panduan lapor polis sah bersama Team Email Rakyat."
>
  <Hero />
  <Features />

  <section
    id="section-tiktok-embed"
    class="site-section bg-[var(--site-surface)]"
  >
    <div class="site-container">
      <div class="grid md:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="md:col-span-7">
          <span class="eyebrow mb-3">Pendedahan Video</span>
          <h2 class="h-section mt-2 mb-6">
            Kes Sebenar Mangsa Ah Long di Malaysia.
          </h2>

          <p class="body-text mb-8">
            Dengarkan rakaman pendedahan bagaimana sindiket pinjaman haram
            memerangkap peminjam dengan bunga berlipat ganda, dan bagaimana isu
            ini dapat diselesaikan berlandaskan peruntukan undang-undang rasmi.
          </p>

          <ul
            class="border-t border-[var(--site-line)] divide-y divide-[var(--site-line)] text-sm text-[var(--site-text)]"
          >
            <li class="py-4 flex items-baseline gap-5">
              <span
                class="font-mono text-xs font-bold text-[var(--site-accent)] tracking-widest shrink-0"
                >01</span
              >
              <span class="font-medium"
                >Kronologi sebenar jerat pinjaman tidak berlesen</span
              >
            </li>
            <li class="py-4 flex items-baseline gap-5">
              <span
                class="font-mono text-xs font-bold text-[var(--site-accent)] tracking-widest shrink-0"
                >02</span
              >
              <span class="font-medium"
                >Kesan psikologi terhadap mangsa dan keluarga</span
              >
            </li>
            <li class="py-4 flex items-baseline gap-5">
              <span
                class="font-mono text-xs font-bold text-[var(--site-accent)] tracking-widest shrink-0"
                >03</span
              >
              <span class="font-medium"
                >Langkah teknikal menghentikan ugutan serta-merta</span
              >
            </li>
          </ul>

          <div class="mt-8">
            <a
              href="https://www.tiktok.com/@teamemail.rakyat/video/7624967321739726101"
              target="_blank"
              rel="noopener noreferrer"
              class="link-arrow text-sm"
            >
              Tonton di saluran rasmi TikTok
            </a>
          </div>
        </div>

        <div class="md:col-span-5 flex justify-center md:justify-end">
          <!-- Smartphone Device Frame (Necessary Border for Video Separation) -->
          <div
            class="w-full max-w-[310px] tiktok-phone-frame p-2.5 rounded-[32px] transition-all duration-300"
          >
            <div
              id="tiktok-facade-container"
              class="relative w-full aspect-[9/16] overflow-hidden rounded-[22px] bg-slate-950 flex flex-col items-center justify-center p-6 text-center cursor-pointer group select-none"
              role="button"
              tabindex="0"
              aria-label="Tonton Kisah Sebenar Mangsa Ah Long di TikTok"
            >
              <!-- Phone Speaker Notch -->
              <div
                class="absolute top-2.5 left-1/2 -translate-x-1/2 w-14 h-1 rounded-full bg-slate-800 pointer-events-none z-10"
              >
              </div>

              <!-- Ambient Subtle Depth Gradient -->
              <div
                class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/60 to-slate-950 pointer-events-none"
              >
              </div>

              <span
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#e2b03a]/15 border border-[#e2b03a]/35 font-mono text-[10px] uppercase tracking-[0.2em] text-[#f0c351] mb-5 relative z-10"
              >
                <span
                  class="w-1.5 h-1.5 rounded-full bg-[#f0c351] animate-pulse"
                ></span>
                Rakaman Rasmi
              </span>

              <!-- Prominent Play Button with Pulse Halo -->
              <div class="relative mb-5 z-10">
                <div
                  class="absolute -inset-2 rounded-full bg-[#e2b03a]/25 blur-md group-hover:bg-[#e2b03a]/50 transition-all duration-300"
                >
                </div>
                <div
                  class="relative w-16 h-16 rounded-full bg-[#e2b03a] text-[#070c18] flex items-center justify-center shadow-lg shadow-[#e2b03a]/30 group-hover:scale-110 group-hover:bg-[#f0c351] transition-all duration-300"
                >
                  <svg
                    class="w-6 h-6 ml-1 fill-current"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M8 5v14l11-7z"></path>
                  </svg>
                </div>
              </div>

              <h3
                class="text-sm font-bold text-white tracking-tight mb-1.5 relative z-10"
                style="color: #ffffff !important;"
              >
                Kisah Sebenar Mangsa Ah Long
              </h3>
              <p
                class="text-xs text-slate-300 group-hover:text-[#f0c351] transition-colors relative z-10 flex items-center gap-1 justify-center"
                style="color: #cbd5e1 !important;"
              >
                <span>Klik untuk memainkan video</span>
                <span class="transition-transform group-hover:translate-x-1"
                  >&rarr;</span
                >
              </p>

              <!-- Phone Bottom Bar Indicator -->
              <div
                class="absolute bottom-2 left-1/2 -translate-x-1/2 w-20 h-1 rounded-full bg-slate-800/80 pointer-events-none z-10"
              >
              </div>

              <template id="tiktok-iframe-template">
                <iframe
                  id="tiktok-player-iframe"
                  src="https://www.tiktok.com/player/v1/7624967321739726101?autoplay=1&description=1&rel=0"
                  class="w-full h-full border-0 rounded-[22px]"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                  allowfullscreen
                  title="Kisah Sebenar Mangsa Ah Long - Team Email Rakyat"
                ></iframe>
              </template>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const container = document.getElementById("tiktok-facade-container");
        const template = document.getElementById("tiktok-iframe-template");
        if (!container || !template) return;

        const loadIframe = () => {
          if (container.dataset.loaded) return;
          container.dataset.loaded = "true";
          container.innerHTML = "";
          container.classList.remove(
            "cursor-pointer",
            "items-center",
            "justify-center",
            "p-8",
            "p-6",
            "text-center",
          );
          const clone = template.content.cloneNode(true);
          container.appendChild(clone);
        };

        container.addEventListener("click", loadIframe, { once: true });
        container.addEventListener(
          "keydown",
          (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              loadIframe();
            }
          },
          { once: true },
        );
      });
    </script>
  </section>

  <FAQ />
</Layout>
