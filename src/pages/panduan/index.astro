---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import defaultBg from '../../assets/banner-panduan.jpg';
import { getCollection } from 'astro:content';

const guides = await getCollection('panduan');
// Sort by publishDate descending
const sortedGuides = guides.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const featuredGuide = sortedGuides[0];

const pageTitle = "Pusat Panduan & Tindakan Undang-Undang Mangsa Ah Long Malaysia | Email Rakyat";
const pageDesc = "Koleksi panduan dan rujukan undang-undang sah bagi mangsa pinjaman tidak berlesen (Ah Long), ugutan ceti haram, dan prosedur laporan polis di Malaysia.";
---

<Layout
  title={pageTitle}
  description={pageDesc}
>
  <Hero
    line1="Pusat Panduan"
    line2="Rujukan Hak & Undang-Undang Malaysia"
    showDetails={false}
    backgroundImage={defaultBg}
  />

  <main class="site-container py-16 md:py-24">

    <!-- Featured Guide: Clean Editorial Feature (Zero Box) -->
    {featuredGuide && (
      <section class="mb-20 border-t border-b border-[var(--site-line)] py-12 md:py-16">
        <div class="max-w-4xl">
          <div class="flex items-center gap-3 mb-4 text-xs font-mono text-[var(--site-subtle)] uppercase">
            <span class="text-[var(--site-accent)] font-bold">Panduan Pilihan</span>
            <span>·</span>
            <span>{featuredGuide.data.category}</span>
            <span>·</span>
            <span>{featuredGuide.data.readTime}</span>
          </div>

          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--site-heading)] tracking-tight leading-tight mb-4">
            <a href={`/panduan/${featuredGuide.id.replace(/\.mdx?$/, '')}`} class="hover:text-[var(--site-accent)] transition-colors">
              {featuredGuide.data.title}
            </a>
          </h2>

          <p class="body-text text-base md:text-lg mb-8 leading-relaxed">
            {featuredGuide.data.description}
          </p>

          <a
            href={`/panduan/${featuredGuide.id.replace(/\.mdx?$/, '')}`}
            class="btn-primary"
          >
            <span>Baca Panduan Lengkap</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )}

    <!-- All Guides: Clean Minimalist Linear Catalogue (Zero Boxes) -->
    <section>
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[var(--site-line)]">
        <h2 class="text-xl font-bold text-[var(--site-heading)] tracking-tight">
          Semua Panduan Khusus ({sortedGuides.length})
        </h2>
        <span class="text-xs font-mono text-[var(--site-subtle)]">Disusun mengikut tarikh</span>
      </div>

      <div class="divide-y divide-[var(--site-line)]">
        {sortedGuides.map((guide, index) => {
          const slug = guide.id.replace(/\.mdx?$/, '');
          return (
            <article class="editorial-row group py-8 md:py-10 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-start">
              <div class="md:col-span-1 text-xs font-mono font-bold text-[var(--site-accent)]">
                {String(index + 1).padStart(2, '0')}
              </div>

              <div class="md:col-span-8">
                <div class="flex items-center gap-2 text-xs font-mono text-[var(--site-subtle)] uppercase mb-2">
                  <span class="text-[var(--site-accent)] font-bold">{guide.data.category}</span>
                  <span>·</span>
                  <span>{guide.data.readTime}</span>
                </div>

                <h3 class="text-xl md:text-2xl font-bold text-[var(--site-heading)] group-hover:text-[var(--site-accent)] transition-colors tracking-tight mb-3">
                  <a href={`/panduan/${slug}`}>
                    {guide.data.title}
                  </a>
                </h3>

                <p class="body-text text-sm md:text-base leading-relaxed mb-4">
                  {guide.data.description}
                </p>

                <span class="text-xs font-mono text-[var(--site-subtle)]">
                  Oleh {guide.data.author.split('(')[0].trim()}
                </span>
              </div>

              <div class="md:col-span-3 md:text-right pt-2 md:pt-0">
                <a
                  href={`/panduan/${slug}`}
                  class="link-arrow text-sm"
                >
                  Baca Panduan
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Immediate Help Note (Zero Box) -->
    <aside class="mt-20 pt-12 border-t border-[var(--site-line)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <h3 class="text-lg font-bold text-[var(--site-heading)] mb-1">
          Perlukan Bantuan Segera Hari Ini?
        </h3>
        <p class="body-text text-sm">
          Jika anda berdepan ugutan langsung daripada pihak sindiket, hubungi talian pegawai bertugas kami segera.
        </p>
      </div>

      <div class="flex items-center gap-4 shrink-0">
        <a
          href="https://WaiYanTeamEmailRakyat.wasap.my"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          WhatsApp Kecemasan
        </a>
        <a
          href="/hubungi"
          class="btn-secondary"
        >
          Hubungi Kami
        </a>
      </div>
    </aside>
  </main>
</Layout>
