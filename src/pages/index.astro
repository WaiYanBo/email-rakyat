---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import FAQ from '../components/FAQ.astro';
---

<Layout
  title="Bantuan Mangsa Ah Long: Ugutan, Simbah Cat & Sebar Gambar | The ER Advocacy (Team Email Rakyat)"
  description="Ah Long ugut saya? Ahlong is harassing or threatening me? Ketahui apa itu Ah Long, cara hadapi kes Ah Long di Malaysia, simbah cat, ugutan sebar gambar IC & panduan lapor polis sah bersama Team Email Rakyat."
>
    <Hero />
    <Features />
    <section id="section-tiktok-embed" class="py-20 px-6 border-b border-gray-800 bg-gradient-to-b from-[#0b1220] to-[#05070d]">
      <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">

        <div class="text-left">
          <h2 class="text-3xl md:text-4xl font-black text-white mb-6">
            Kes Sebenar Mangsa Ah Long
          </h2>

          <p class="text-gray-400 text-lg mb-6 leading-relaxed">
            Dengarkan kisah sebenar mangsa yang terjebak dengan hutang Ah Long
            sehingga mencecah jutaan ringgit. Ketahui bagaimana situasi ini berlaku
            dan langkah yang boleh diambil untuk keluar dari masalah secara sah.
          </p>

          <ul class="space-y-3 text-gray-300">
            <li>✔ Kisah sebenar mangsa hutang</li>
            <li>✔ Risiko pinjaman tidak berlesen</li>
            <li>✔ Cara penyelesaian yang sah</li>
          </ul>
        </div>

        <div class="flex justify-center md:justify-end w-full min-w-0">

          <div class="bg-black/40 backdrop-blur-lg p-3 sm:p-4 rounded-2xl shadow-xl border border-gray-700 w-full max-w-[340px] min-w-0 flex flex-col items-center">
            <div class="relative w-full aspect-[9/16] min-h-[580px] rounded-xl overflow-hidden bg-gray-900/60 shadow-inner">
              <iframe
                id="tiktok-player-iframe"
                src="https://www.tiktok.com/player/v1/7624967321739726101?autoplay=1&description=1&rel=0"
                class="w-full h-full border-0 rounded-xl"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                allowfullscreen
                loading="lazy"
                title="Kisah Sebenar Mangsa Ah Long - Team Email Rakyat"
              ></iframe>
            </div>

            <a
              href="https://www.tiktok.com/@teamemail.rakyat/video/7624967321739726101"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 text-xs text-gray-400 hover:text-white transition-colors flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.86 4.43V13a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-3.04-1.29v-3.14z"/>
              </svg>
              <span>Buka video di TikTok &rarr;</span>
            </a>
          </div>
        </div>

      </div>

      <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
          const iframe = document.getElementById("tiktok-player-iframe");
          if (!iframe) return;

          const triggerPlay = () => {
            try {
              if (iframe.contentWindow) {
                const playMsg = { "x-tiktok-player": true, type: "play" };
                iframe.contentWindow.postMessage(playMsg, "*");
                iframe.contentWindow.postMessage(JSON.stringify(playMsg), "*");
              }
            } catch (_) {}
          };

          const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                triggerPlay();
                setTimeout(triggerPlay, 1200);
                obs.disconnect();
              }
            });
          }, { threshold: 0.25 });

          observer.observe(iframe);
        });
      </script>
    </section>

    <FAQ />

</Layout>
